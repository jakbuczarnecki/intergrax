{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": "python scripts/hooks/igx_subagent_guard.py",
        "matcher": "^generalPurpose$",
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "python scripts/hooks/igx_stop_guard.py",
        "loop_limit": null
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python scripts/hooks/igx_cursor_integration_guard.py",
        "matcher": "([gG][iI][tT]|[gG][hH]|[cC][uU][rR][lL])",
        "failClosed": true
      }
    ]
  }
}
