# =============================================================================
# Intergrax -- example platform configuration
# Copy to .env (gitignored) and fill in values.
#
# Role: a practical example of common Intergrax platform configuration.
# Not an application catalog, proof/dev tooling list, or exhaustive docs.
#
# For the complete supported configuration reference, defaults and provider
# details, see:
#   docs/project/technical/guides/PLATFORM_CONFIGURATION.md
# Provider catalog: docs/project/architecture/LLM_ADAPTERS.md
#
# Intergrax does not auto-load .env; the process / entrypoint must export these.
# Secrets: leave blank, use a placeholder, or keep commented. Never commit real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Core defaults
# -----------------------------------------------------------------------------
INTERGRAX_DEFAULT_LANGUAGE=pl
INTERGRAX_DEFAULT_LOCALE=pl-PL
INTERGRAX_DEFAULT_REGION=pl-PL
INTERGRAX_DEFAULT_TIMEZONE=Europe/Warsaw
# INTERGRAX_DEFAULT_USER_TURNS_CONSOLIDATION_INTERVAL=
# INTERGRAX_DEFAULT_CONSOLIDATION_COOLDOWN_SECONDS=

# -----------------------------------------------------------------------------
# Generation LLM
# Canonical selection pair. Adapter fallbacks (INTERGRAX_DEFAULT_*_MODEL) are
# not the primary contract -- see PLATFORM_CONFIGURATION.md.
# -----------------------------------------------------------------------------
INTERGRAX_LLM_PROVIDER=ollama
INTERGRAX_LLM_MODEL=llama3.1:latest

# -----------------------------------------------------------------------------
# Embeddings
# Canonical selection pair, independent from generation.
# -----------------------------------------------------------------------------
INTERGRAX_EMBEDDING_PROVIDER=ollama
INTERGRAX_EMBEDDING_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# Provider connection / auth
# Set only what the chosen provider needs. Full catalog:
# PLATFORM_CONFIGURATION.md and LLM_ADAPTERS.md.
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434

# vLLM -- example Docker host mapping, not a runtime default
# (adapter fallback is http://127.0.0.1:8000/v1).
# INTERGRAX_DEFAULT_VLLM_BASE_URL=http://127.0.0.1:8100/v1
# INTERGRAX_DEFAULT_VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# INTERGRAX_DEFAULT_VLLM_EMBED_BASE_URL=http://127.0.0.1:8101/v1
# VLLM_API_KEY=

# llama.cpp -- example Docker host mapping
# (adapter fallback is http://127.0.0.1:8080/v1).
# INTERGRAX_DEFAULT_LLAMA_CPP_BASE_URL=http://127.0.0.1:8102/v1
# INTERGRAX_DEFAULT_LLAMA_CPP_EMBED_BASE_URL=http://127.0.0.1:8103/v1
# LLAMA_CPP_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
# INTERGRAX_DEFAULT_AZURE_OPENAI_ENDPOINT=
# INTERGRAX_DEFAULT_AZURE_OPENAI_API_VERSION=
# INTERGRAX_DEFAULT_AZURE_OPENAI_DEPLOYMENT=

# AWS Bedrock (auth: standard AWS credential chain)
# INTERGRAX_DEFAULT_AWS_REGION=
# INTERGRAX_DEFAULT_BEDROCK_MODEL_ID=

# Vertex Gemini (Application Default Credentials; no API key env)
# INTERGRAX_VERTEX_PROJECT=

# -----------------------------------------------------------------------------
# Document parsing
# -----------------------------------------------------------------------------
# Allowed: none | local | server
INTERGRAX_DOCLING_MODE=local
INTERGRAX_DOCLING_SERVER_URL=http://localhost:8000
INTERGRAX_DOCLING_SERVER_PATH=/parse
INTERGRAX_DOCLING_TIMEOUT=120

# -----------------------------------------------------------------------------
# Search / reranking
# Preferred INTERGRAX_* names; legacy aliases still accepted by runtime.
# -----------------------------------------------------------------------------
# INTERGRAX_GOOGLE_CSE_API_KEY=
# INTERGRAX_GOOGLE_CSE_CX=
# Legacy aliases: GOOGLE_CSE_API_KEY, GOOGLE_CSE_CX

# INTERGRAX_BING_API_KEY=
# Legacy alias: BING_SEARCH_V7_API_KEY

# GOOGLE_PLACES_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

COHERE_API_KEY=
# INTERGRAX_DEFAULT_COHERE_RERANK_MODEL=
JINA_API_KEY=
# INTERGRAX_DEFAULT_JINA_RERANK_MODEL=

# -----------------------------------------------------------------------------
# Persistence
# Default SQLite files live under INTERGRAX_SQLITE_DATA_DIR (platform default: build).
# -----------------------------------------------------------------------------
# INTERGRAX_SQLITE_DATA_DIR=build
# INTERGRAX_RELATIONAL_DB=
# INTERGRAX_TRACE_DB=
# INTERGRAX_RUNTIME_EVENTS_DB=
# INTERGRAX_TASK_CHECKPOINTS_DB=
# INTERGRAX_TASK_MEMORY_DB=
# INTERGRAX_HUMAN_DECISIONS_DB=
# INTERGRAX_EXPERIMENTS_DB=
# INTERGRAX_IDEMPOTENCY_DB=
# INTERGRAX_SESSION_DB=
# INTERGRAX_ORGANIZATION_DB=
# INTERGRAX_USER_PROFILE_DB=

# -----------------------------------------------------------------------------
# Notifications / interactions
# Default notification backend is log (no network).
# Allowed backends: log | webhook | slack | teams | pagerduty | opsgenie
# -----------------------------------------------------------------------------
# INTERGRAX_NOTIFICATION_BACKEND=log
# INTERGRAX_WEBHOOK_URL=
# INTERGRAX_SLACK_WEBHOOK_URL=
# INTERGRAX_TEAMS_WEBHOOK_URL=
# INTERGRAX_PAGERDUTY_ROUTING_KEY=
# INTERGRAX_OPSGENIE_API_KEY=

# Allowed surface: auto | lab | lab_json | slack | slash_command | teams
# INTERGRAX_INTERACTION_SURFACE=auto
# Allowed verifier: none | slack | teams
# INTERGRAX_INBOUND_VERIFIER=none
# INTERGRAX_SLACK_SIGNING_SECRET=
# INTERGRAX_TEAMS_SECURITY_TOKEN=

# -----------------------------------------------------------------------------
# Workspace / sandbox
# -----------------------------------------------------------------------------
# INTERGRAX_SHADOW_ROOT=
# INTERGRAX_SANDBOX_ROOT=

# -----------------------------------------------------------------------------
# Scheduler / workers
# -----------------------------------------------------------------------------
# INTERGRAX_SCHEDULER_POLL_SECONDS=30
# INTERGRAX_CELERY_BROKER_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Observability
# INTERGRAX_EXPORT_JOURNAL is enabled by default (1). Set 0 / false / no / off to disable.
# -----------------------------------------------------------------------------
# INTERGRAX_EXPORT_JOURNAL=1
# INTERGRAX_EXPORT_PARSER_TRACE=1
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# INTERGRAX_LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Common integration slug examples (not an exhaustive catalog).
# Pattern: INTERGRAX_INTEGRATION_<CATEGORY>=<slug>
INTERGRAX_INTEGRATION_RELATIONAL_STORE=sqlite
INTERGRAX_INTEGRATION_DOCUMENT_PARSER=docling
# INTERGRAX_INTEGRATION_RERANK_PROVIDER=cohere_rerank
# INTERGRAX_INTEGRATION_VECTOR_STORE=chroma
# INTERGRAX_INTEGRATION_SEARCH_PROVIDER=google_cse
# INTERGRAX_INTEGRATION_OBSERVABILITY_BACKEND=langfuse

# Diagnostic Problem list cursor HMAC secret (minimum 32 UTF-8 bytes; random; rotation invalidates cursors)
INTERGRAX_DIAGNOSTIC_PROBLEM_LIST_CURSOR_SECRET=

# -----------------------------------------------------------------------------
# VPI scenario (verified product identification) — embedding materialization
# See platform_proofs/scenarios/verified_product_identification/EMBEDDING_MATERIALIZATION_ARCHITECTURE.md
# -----------------------------------------------------------------------------
# VPI_EMBEDDING_PROVIDER=hf
# VPI_EMBEDDING_MODEL=BAAI/bge-m3
# VPI_EMBEDDING_DIMENSION=1024
# VPI_EMBEDDING_ARTIFACT_PATH=platform_proofs/scenarios/verified_product_identification/dataset/processed/embedding_artifacts
# VPI_EMBEDDING_ARTIFACT_SHARD_SIZE=10000
# VPI_EMBEDDING_MATERIALIZATION_BATCH_SIZE=64
# VPI_EMBEDDING_MATERIALIZATION_MAX_RECORDS=1000
