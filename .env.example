# =============================================================================
# Intergrax — example environment variables
# Copy to `.env` (listed in `.gitignore`) and fill in values.
# This list is derived from `os.getenv` / `os.environ` usage in the Python codebase
# (plus a few ecosystem conventions, noted explicitly).
# =============================================================================

# -----------------------------------------------------------------------------
# Global defaults (intergrax/globals/settings.py)
# -----------------------------------------------------------------------------
# Language / locale / region fallbacks used across the framework.
INTERGRAX_DEFAULT_LANGUAGE=pl
INTERGRAX_DEFAULT_LOCALE=pl-PL
INTERGRAX_DEFAULT_REGION=pl-PL
INTERGRAX_DEFAULT_TIMEZONE=Europe/Warsaw

# Optional: session memory consolidation (digits only — see implementation).
# INTERGRAX_DEFAULT_USER_TURNS_CONSOLIDATION_INTERVAL=
# INTERGRAX_DEFAULT_CONSOLIDATION_COOLDOWN_SECONDS=

# -----------------------------------------------------------------------------
# Ollama — chat (e2e tests + local dev)
# -----------------------------------------------------------------------------
# Ollama HTTP API base URL (e.g. tests/_support/builder.require_ollama_reachable).
# Clients often default to http://127.0.0.1:11434 — override if your setup differs.
OLLAMA_HOST=http://127.0.0.1:11434

# Ollama chat model (LangChainOllamaAdapter reads INTERGRAX_LLM_MODEL and INTERGRAX_DEFAULT_OLLAMA_MODEL).
INTERGRAX_LLM_PROVIDER=ollama
INTERGRAX_LLM_MODEL=<model>
INTERGRAX_DEFAULT_OLLAMA_MODEL=<model>

# -----------------------------------------------------------------------------
# Embeddings — provider-neutral selection (embedding_profile_from_env)
# -----------------------------------------------------------------------------
INTERGRAX_EMBEDDING_PROVIDER=ollama
INTERGRAX_EMBEDDING_MODEL=nomic-embed-text


# -----------------------------------------------------------------------------
# vLLM — self-hosted production LLM (intergrax/llm_adapters/providers/openai_compat_providers.py)
# -----------------------------------------------------------------------------
# OpenAI-compatible API base URL. Native vLLM default is http://127.0.0.1:8000/v1;
# Intergrax Docker maps host 8100 → container 8000 (see infra/PORTS.md).
INTERGRAX_DEFAULT_VLLM_BASE_URL=http://127.0.0.1:8100/v1
INTERGRAX_DEFAULT_VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# VLLM_API_KEY=EMPTY   # optional; vLLM often runs without auth locally

# Platform LLM selection (llm_profile_from_env):
# INTERGRAX_LLM_PROVIDER=vllm
# INTERGRAX_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# vLLM embeddings (intergrax/rag/embedding/providers/vllm_embedding_provider.py)
# Separate embed server recommended — see infra/docker/vllm-embed (host port 8101).
INTERGRAX_DEFAULT_VLLM_EMBED_BASE_URL=http://127.0.0.1:8101/v1

# -----------------------------------------------------------------------------
# llama.cpp — CPU-friendly self-hosted LLM (openai_compat_providers.py)
# -----------------------------------------------------------------------------
# OpenAI-compatible API base URL. Native llama.cpp default is http://127.0.0.1:8080/v1;
# Intergrax Docker maps host 8102 → container 8080 (see infra/PORTS.md).
INTERGRAX_DEFAULT_LLAMA_CPP_BASE_URL=http://127.0.0.1:8102/v1
INTERGRAX_DEFAULT_LLAMA_CPP_MODEL=default
# LLAMA_CPP_API_KEY=EMPTY   # optional; local server often runs without auth

# Platform LLM selection (llm_profile_from_env):
# INTERGRAX_LLM_PROVIDER=llama_cpp
# INTERGRAX_LLM_MODEL=default

# llama.cpp embeddings (intergrax/rag/embedding/providers/llama_cpp_embedding_provider.py)
# Separate embed server recommended — see infra/docker/llama-cpp-embed (host port 8103).
INTERGRAX_DEFAULT_LLAMA_CPP_EMBED_BASE_URL=http://127.0.0.1:8103/v1

# -----------------------------------------------------------------------------
# LLM — OpenAI (intergrax/llm_adapters/providers/openai_responses_adapter.py)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
INTERGRAX_DEFAULT_OPENAI_MODEL=

# -----------------------------------------------------------------------------
# LLM — Anthropic Claude (intergrax/llm_adapters/providers/claude_adapter.py)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
INTERGRAX_DEFAULT_CLAUDE_MODEL=

# -----------------------------------------------------------------------------
# LLM — Google Gemini (intergrax/llm_adapters/providers/gemini_adapter.py)
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=
INTERGRAX_DEFAULT_GEMINI_MODEL=

# -----------------------------------------------------------------------------
# LLM — Mistral (intergrax/llm_adapters/providers/mistral_adapter.py)
# -----------------------------------------------------------------------------
MISTRAL_API_KEY=
INTERGRAX_DEFAULT_MISTRAL_MODEL=

# -----------------------------------------------------------------------------
# LLM — Azure OpenAI (intergrax/llm_adapters/providers/azure_openai_adapter.py)
# -----------------------------------------------------------------------------
# API key is read by the official Azure OpenAI SDK (AZURE_OPENAI_API_KEY); see adapter comments.
AZURE_OPENAI_API_KEY=
INTERGRAX_DEFAULT_AZURE_OPENAI_ENDPOINT=
INTERGRAX_DEFAULT_AZURE_OPENAI_API_VERSION=
INTERGRAX_DEFAULT_AZURE_OPENAI_DEPLOYMENT=

# -----------------------------------------------------------------------------
# LLM — AWS Bedrock (intergrax/llm_adapters/providers/aws_bedrock_adapter.py)
# -----------------------------------------------------------------------------
# Region and model id are required by the adapter. Auth: standard boto3 credential chain
# (e.g. AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, SSO profile, IAM role).
INTERGRAX_DEFAULT_AWS_REGION=
INTERGRAX_DEFAULT_BEDROCK_MODEL_ID=

# Not read directly by Intergrax — common for Hub with private models / rate limits:
# HF_TOKEN=

# -----------------------------------------------------------------------------
# Reranking — Cohere / Jina (intergrax/rag/rerankers/providers/)
# -----------------------------------------------------------------------------
COHERE_API_KEY=
INTERGRAX_DEFAULT_COHERE_RERANK_MODEL=

JINA_API_KEY=
INTERGRAX_DEFAULT_JINA_RERANK_MODEL=

# -----------------------------------------------------------------------------
# Web search — providers (intergrax/websearch/providers/)
# -----------------------------------------------------------------------------
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

BING_SEARCH_V7_API_KEY=

GOOGLE_PLACES_API_KEY=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional — a default exists in code; override if needed.
# REDDIT_USER_AGENT=

# -----------------------------------------------------------------------------
# Docling — document parsing (intergrax/rag/document_loaders/config/document_loader_config.py)
# -----------------------------------------------------------------------------
# Allowed: none | local | server
INTERGRAX_DOCLING_MODE=local
INTERGRAX_DOCLING_SERVER_URL=http://localhost:8000
INTERGRAX_DOCLING_SERVER_PATH=/parse
INTERGRAX_DOCLING_TIMEOUT=120

# -----------------------------------------------------------------------------
# OpenAI Vector Store (optional integrations / agent experiments)
# -----------------------------------------------------------------------------
# Not used by the core Nexus runtime.
# VECTOR_STORE_ID=

# -----------------------------------------------------------------------------
# Runtime persistence (SQLite paths — optional; inject stores in composition root)
# -----------------------------------------------------------------------------
# Run trace (debug CLI / API). Default: build/intergrax_trace.db
# INTERGRAX_TRACE_DB=
#
# Runtime events (NexusLoop + debug API). Default: build/intergrax_runtime_events.db
# Enabled by default in Legal / Research app factories (wire_nexus_observability).
# INTERGRAX_RUNTIME_EVENTS_DB=
#
# Task checkpoints (long-running resume). Default: build/intergrax_task_checkpoints.db
# INTERGRAX_TASK_CHECKPOINTS_DB=
#
# Task memory (I.1 bounded writes). Default: build/intergrax_task_memory.db
# INTERGRAX_TASK_MEMORY_DB=
#
# Human decisions (HITL store). Default: build/intergrax_human_decisions.db
# INTERGRAX_HUMAN_DECISIONS_DB=
#
# Experiment registry (debug API / lab). Default: build/intergrax_experiments.db
# INTERGRAX_EXPERIMENTS_DB=

# -----------------------------------------------------------------------------
# Runtime — notifications (Phase H.1; default: log-only, no network)
# -----------------------------------------------------------------------------
# Allowed backend: log | webhook | slack | teams
# INTERGRAX_NOTIFICATION_BACKEND=log
# INTERGRAX_WEBHOOK_URL=
# INTERGRAX_SLACK_WEBHOOK_URL=
# INTERGRAX_TEAMS_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Runtime — inbound interactions (Phase H.2–H.5; debug API / lab)
# -----------------------------------------------------------------------------
# Allowed surface: auto | lab | slash_command | teams
# INTERGRAX_INTERACTION_SURFACE=auto
#
# Inbound signature verification: none | slack | teams
# INTERGRAX_INBOUND_VERIFIER=none
# For production Slack / Teams webhooks (lab POST /v1/interactions/intake, B.12):
# INTERGRAX_INBOUND_VERIFIER=slack
# INTERGRAX_INBOUND_VERIFIER=teams
# INTERGRAX_SLACK_SIGNING_SECRET=
# INTERGRAX_SLACK_VERIFY_SIGNATURE=false
# INTERGRAX_TEAMS_SECURITY_TOKEN=
# INTERGRAX_TEAMS_VERIFY_SIGNATURE=false

# -----------------------------------------------------------------------------
# Runtime — workspace & sandbox (Phase F)
# -----------------------------------------------------------------------------
# INTERGRAX_SHADOW_ROOT=
# INTERGRAX_SANDBOX_ROOT=

# -----------------------------------------------------------------------------
# Local infrastructure (Docker) — not Intergrax env vars, but useful for dev
# -----------------------------------------------------------------------------
# See infra/integration/docker-compose.yml (PostgreSQL, Redis, Kafka, RabbitMQ, Qdrant, Chroma).
# Example Postgres from that file: user/password/database `intergrax`, port 5432.

# -----------------------------------------------------------------------------
# Legal backend host (legal_application.host) — Tier-3 FastAPI entrypoint
# -----------------------------------------------------------------------------
# See applications/legal_application/host/README.md
# Run from repo root: uv run python -m legal_application.host.main
#
# LEGAL_BACKEND_ENV=dev
# LEGAL_BACKEND_HOST=0.0.0.0
# LEGAL_BACKEND_PORT=8000
# LEGAL_BACKEND_RELOAD=false
#
# Tier-2 Legal SKU + LLM (LLM_* keys still apply per provider).
# LEGAL_PRODUCT_PROFILE=strict_legal
# LEGAL_LLM_PROVIDER=ollama
# LEGAL_DEFAULT_AGENT_ID=legal-default
# LEGAL_ROUTE_PREFIX=/v1/legal
#
# Identity: in prod defaults to context_only (requires API key → RequestContext tenant/user).
# LEGAL_IDENTITY_SOURCE=body_or_context
#
# Auth (pick one): single bootstrap key for MVP, or JSON map for several keys.
# LEGAL_BACKEND_BOOTSTRAP_API_KEY=
# LEGAL_BACKEND_BOOTSTRAP_TENANT_ID=
# LEGAL_BACKEND_BOOTSTRAP_USER_ID=
# LEGAL_BACKEND_API_KEYS_JSON={"demo-key":{"tenant_id":"t1","user_id":"u1","scopes":["*"]}}
#
# Emergency only (never on public internet):
# LEGAL_BACKEND_ALLOW_UNAUTHENTICATED=false
#
# Optional persistent sessions (SQLite). When unset, sessions are in-process only.
# LEGAL_SESSION_SQLITE_PATH=
#
# CORS (comma-separated origins). Empty = CORS middleware not added.
# LEGAL_BACKEND_CORS_ORIGINS=https://app.example.com
#
# OpenAPI override (prod defaults docs off): force on or off.
# LEGAL_BACKEND_OPENAPI=

# -----------------------------------------------------------------------------
# Research backend host (research_application.host) — Tier-3 FastAPI entrypoint
# -----------------------------------------------------------------------------
# Run from repo root: uv run python -m research_application.host.main
#
# RESEARCH_BACKEND_HOST=0.0.0.0
# RESEARCH_BACKEND_PORT=8010
# RESEARCH_BACKEND_RELOAD=false
# RESEARCH_ROUTE_PREFIX=/v1/research
#
# NexusLoop is required (default). Legacy path is not supported on Research host.
# RESEARCH_USE_LEGACY_AGENT_ENGINE=false

# -----------------------------------------------------------------------------
# Lab application host (lab_application.host) — Tier-3 Agent OS experimentation
# -----------------------------------------------------------------------------
# Run from repo root: uv run uvicorn lab_application.host.main:app --host 127.0.0.1 --port 8090
#
# LAB_ROUTE_PREFIX=/v1/lab
# LAB_INCLUDE_MOCK_AGENTS=true
# LAB_INCLUDE_ECHO=true
# LAB_INCLUDE_SIGNOFF_PROBE=true
# LAB_INCLUDE_RESEARCH=false
# Production inbound Slack / Teams / lab webhooks (B.12):
# LAB_INCLUDE_INTERACTIONS=true
# LAB_INTERACTION_ROUTE_PREFIX=/v1/interactions
# HITL timeout / delayed resume scheduler (B.05):
# LAB_INCLUDE_SCHEDULER=true
# INTERGRAX_SCHEDULER_POLL_SECONDS=30

# -----------------------------------------------------------------------------
# Nexus worker queue (Phase J.3) — optional async Task v2 execution
# -----------------------------------------------------------------------------
# When wiring QueuedNexusExecutionAdapter instead of in-process NexusTaskExecutionAdapter:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# INTERGRAX_USE_WORKER_QUEUE=true
# INTERGRAX_SCHEDULER_POLL_SECONDS=30

# -----------------------------------------------------------------------------
# Integration Library — Tier-3 provider selection (Phase M.3+)
# Pattern: INTERGRAX_INTEGRATION_<CATEGORY>=<slug>
# Categories: relational_store, document_parser, rerank_provider, vector_store,
#             search_provider, observability_backend, key_value_cache, …
# -----------------------------------------------------------------------------
INTERGRAX_INTEGRATION_RELATIONAL_STORE=sqlite
INTERGRAX_INTEGRATION_DOCUMENT_PARSER=docling
# INTERGRAX_INTEGRATION_RERANK_PROVIDER=cohere_rerank
# INTERGRAX_INTEGRATION_VECTOR_STORE=chroma
# INTERGRAX_INTEGRATION_SEARCH_PROVIDER=google_cse
# INTERGRAX_INTEGRATION_OBSERVABILITY_BACKEND=langfuse

# Docling server (when INTERGRAX_DOCLING_MODE=server)
INTERGRAX_DOCLING_MODE=local
INTERGRAX_DOCLING_SERVER_URL=http://localhost:8000
INTERGRAX_DOCLING_SERVER_PATH=/parse

# Export unified run journal OTLP snapshot on TASK_COMPLETED (default: on)
# INTERGRAX_EXPORT_JOURNAL=1

# Export parser pipeline traces to Langfuse/Sentry when observability slug is set
# INTERGRAX_EXPORT_PARSER_TRACE=1
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# INTERGRAX_LANGFUSE_BASE_URL=https://cloud.langfuse.com


# -----------------------------------------------------------------------------
# LKW Ollama/vLLM model runtime portability proof
# Explicit opt-in; live network/provider proof, not intended for normal CI.
# -----------------------------------------------------------------------------
INTERGRAX_LKW_MODEL_RUNTIME_PROOF=0

# Exact qualified local model pair used by the current proof.
LKW_MODEL_RUNTIME_PROOF_OLLAMA_MODEL=qwen2.5:14b
LKW_MODEL_RUNTIME_PROOF_VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct

LKW_MODEL_RUNTIME_PROOF_OLLAMA_BASE_URL=http://127.0.0.1:11434
LKW_MODEL_RUNTIME_PROOF_VLLM_BASE_URL=http://127.0.0.1:8100/v1

# Must be explicitly verified by the operator.
# Supported: committed_compose_sufficient, external_runtime, unverified
# unverified blocks proof PASS.
LKW_MODEL_RUNTIME_PROOF_VLLM_PROVISIONING_CLASSIFICATION=unverified

# Optional proof runtime settings
# LKW_MODEL_RUNTIME_PROOF_VECTOR_STORE=qdrant
# LKW_MODEL_RUNTIME_PROOF_QDRANT_URL=http://127.0.0.1:6333
# LKW_MODEL_RUNTIME_PROOF_TIMEOUT_SECONDS=300
# -----------------------------------------------------------------------------
# GitHub — local repository metadata sync (.github/repo-management/README.md)
# Fine-grained PAT: Administration Read and write on intergrax only.
# Never commit this file with a real token.
# -----------------------------------------------------------------------------
GH_TOKEN=

# -----------------------------------------------------------------------------
# Loading `.env` in applications
# -----------------------------------------------------------------------------
# Some scripts/notebooks use `python-dotenv` (e.g. load_dotenv()). The Intergrax library
# does not auto-load `.env` — it depends on your entrypoint.
