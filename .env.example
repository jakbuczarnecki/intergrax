# =============================================================================
# Intergrax — example environment variables
# Copy to `.env` (listed in `.gitignore`) and fill in values.
# This list is derived from `os.getenv` / `os.environ` usage in the Python codebase
# (plus a few ecosystem conventions, noted explicitly).
# =============================================================================

# -----------------------------------------------------------------------------
# Global defaults (intergrax/globals/settings.py)
# -----------------------------------------------------------------------------
# Language / locale / region fallbacks used across the framework.
INTERGRAX_DEFAULT_LANGUAGE=pl
INTERGRAX_DEFAULT_LOCALE=pl-PL
INTERGRAX_DEFAULT_REGION=pl-PL
INTERGRAX_DEFAULT_TIMEZONE=Europe/Warsaw

# Optional: session memory consolidation (digits only — see implementation).
# INTERGRAX_DEFAULT_USER_TURNS_CONSOLIDATION_INTERVAL=
# INTERGRAX_DEFAULT_CONSOLIDATION_COOLDOWN_SECONDS=

# -----------------------------------------------------------------------------
# Ollama — chat and embeddings (e2e tests + local dev)
# -----------------------------------------------------------------------------
# Ollama HTTP API base URL (e.g. tests/_support/builder.require_ollama_reachable).
# Clients often default to http://127.0.0.1:11434 — override if your setup differs.
OLLAMA_HOST=http://127.0.0.1:11434

# Ollama embedding model (intergrax/rag/embedding/providers/ollama_embedding_provider.py).
INTERGRAX_DEFAULT_OLLAMA_EMBED_MODEL=

# Note: the Ollama chat adapter (LangChain) does not read INTERGRAX_DEFAULT_OLLAMA_MODEL
# from env in this repo — configure the chat model in app code or via Ollama/LangChain conventions.

# -----------------------------------------------------------------------------
# LLM — OpenAI (intergrax/llm_adapters/providers/openai_responses_adapter.py)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
INTERGRAX_DEFAULT_OPENAI_MODEL=

# -----------------------------------------------------------------------------
# LLM — Anthropic Claude (intergrax/llm_adapters/providers/claude_adapter.py)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
INTERGRAX_DEFAULT_CLAUDE_MODEL=

# -----------------------------------------------------------------------------
# LLM — Google Gemini (intergrax/llm_adapters/providers/gemini_adapter.py)
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=
INTERGRAX_DEFAULT_GEMINI_MODEL=

# -----------------------------------------------------------------------------
# LLM — Mistral (intergrax/llm_adapters/providers/mistral_adapter.py)
# -----------------------------------------------------------------------------
MISTRAL_API_KEY=
INTERGRAX_DEFAULT_MISTRAL_MODEL=

# -----------------------------------------------------------------------------
# LLM — Azure OpenAI (intergrax/llm_adapters/providers/azure_openai_adapter.py)
# -----------------------------------------------------------------------------
# API key is read by the official Azure OpenAI SDK (AZURE_OPENAI_API_KEY); see adapter comments.
AZURE_OPENAI_API_KEY=
INTERGRAX_DEFAULT_AZURE_OPENAI_ENDPOINT=
INTERGRAX_DEFAULT_AZURE_OPENAI_API_VERSION=
INTERGRAX_DEFAULT_AZURE_OPENAI_DEPLOYMENT=

# -----------------------------------------------------------------------------
# LLM — AWS Bedrock (intergrax/llm_adapters/providers/aws_bedrock_adapter.py)
# -----------------------------------------------------------------------------
# Region and model id are required by the adapter. Auth: standard boto3 credential chain
# (e.g. AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, SSO profile, IAM role).
INTERGRAX_DEFAULT_AWS_REGION=
INTERGRAX_DEFAULT_BEDROCK_MODEL_ID=

# -----------------------------------------------------------------------------
# Embeddings — OpenAI (intergrax/rag/embedding/providers/openai_embedding_provider.py)
# -----------------------------------------------------------------------------
INTERGRAX_DEFAULT_OPENAI_EMBED_MODEL=

# -----------------------------------------------------------------------------
# Embeddings — Hugging Face SentenceTransformers (intergrax/rag/embedding/providers/hf_embedding_provider.py)
# -----------------------------------------------------------------------------
INTERGRAX_DEFAULT_HF_EMBED_MODEL=
# Not read directly by Intergrax — common for Hub with private models / rate limits:
# HF_TOKEN=

# -----------------------------------------------------------------------------
# Reranking — Cohere / Jina (intergrax/rag/rerankers/providers/)
# -----------------------------------------------------------------------------
COHERE_API_KEY=
INTERGRAX_DEFAULT_COHERE_RERANK_MODEL=

JINA_API_KEY=
INTERGRAX_DEFAULT_JINA_RERANK_MODEL=

# -----------------------------------------------------------------------------
# Web search — providers (intergrax/websearch/providers/)
# -----------------------------------------------------------------------------
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

BING_SEARCH_V7_API_KEY=

GOOGLE_PLACES_API_KEY=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional — a default exists in code; override if needed.
# REDDIT_USER_AGENT=

# -----------------------------------------------------------------------------
# Docling — document parsing (intergrax/rag/document_loaders/config/document_loader_config.py)
# -----------------------------------------------------------------------------
# Allowed: none | local | server
INTERGRAX_DOCLING_MODE=local
INTERGRAX_DOCLING_SERVER_URL=http://localhost:8000
INTERGRAX_DOCLING_TIMEOUT=120

# -----------------------------------------------------------------------------
# Notebooks (e.g. notebooks/openai/*) — OpenAI Vector Store
# -----------------------------------------------------------------------------
# Used by some presentation notebooks, not by the core Nexus runtime.
# VECTOR_STORE_ID=

# -----------------------------------------------------------------------------
# Local infrastructure (Docker) — not Intergrax env vars, but useful for dev
# -----------------------------------------------------------------------------
# See infra/integration/docker-compose.yml (PostgreSQL, Redis, Kafka, RabbitMQ, Qdrant, Chroma).
# Example Postgres from that file: user/password/database `intergrax`, port 5432.

# -----------------------------------------------------------------------------
# Loading `.env` in applications
# -----------------------------------------------------------------------------
# Some scripts/notebooks use `python-dotenv` (e.g. load_dotenv()). The Intergrax library
# does not auto-load `.env` — it depends on your entrypoint.
