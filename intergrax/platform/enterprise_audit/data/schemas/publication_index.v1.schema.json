{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "publication_index.v1",
  "type": "object",
  "required": [
    "schema_version",
    "qualification_sha",
    "publication_role",
    "l3_bundle_relpath",
    "artifacts",
    "qual_wave_report"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "qualification_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "publication_role": { "type": "string" },
    "l3_bundle_relpath": { "type": "string" },
    "qual_wave_report": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
