# VPI bootstrap — scenario-owned settings (platform provider vars remain INTERGRAX_*)

# Dataset
# VPI_BOOTSTRAP_DATASET_PATH=platform_proofs/scenarios/verified_product_identification/dataset/processed/selected_offers.parquet
# VPI_BOOTSTRAP_DATASET_MANIFEST_PATH=platform_proofs/scenarios/verified_product_identification/dataset/processed/selected_offers_manifest.json
# VPI_BOOTSTRAP_DATASET_VERIFICATION=fast
# VPI_BOOTSTRAP_MAX_RECORDS=

# Batching
# VPI_BOOTSTRAP_SOURCE_BATCH_SIZE=256
# VPI_BOOTSTRAP_VECTOR_BATCH_SIZE=64

# Catalog / search identity
# VPI_BOOTSTRAP_CATALOG_ID=wdc-v2-selected
# VPI_BOOTSTRAP_POSTGRESQL_SCHEMA=vpi
# VPI_BOOTSTRAP_QDRANT_COLLECTION=vpi_offers

# Embedding (Gate 0 + dense index)
VPI_EMBEDDING_PROVIDER=hf
VPI_EMBEDDING_MODEL=BAAI/bge-m3
VPI_EMBEDDING_DIMENSION=1024

# Platform providers (reference deployment)
# INTERGRAX_POSTGRESQL_DSN=postgresql://intergrax@localhost:5432/intergrax
# INTERGRAX_QDRANT_URL=http://localhost:6333
