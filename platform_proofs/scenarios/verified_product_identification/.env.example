# Scenario proof configuration — copy to .env and set values before running the proof.
# Precedence: process environment > this file > scenario reference defaults
# (loaded by scripts/proof/intergrax_proof_environment.py — do not add a proof-local loader).

# --- LLM (optional until proof runner is wired) ---
# INTERGRAX_LLM_PROVIDER=
# INTERGRAX_LLM_MODEL=

# --- Embedding (VPI scenario-owned; does not override INTERGRAX_EMBEDDING_*) ---
# Canonical reference default — swappable without changing application code.
VPI_EMBEDDING_PROVIDER=hf
VPI_EMBEDDING_MODEL=BAAI/bge-m3
VPI_EMBEDDING_DIMENSION=1024

# Provider-native credentials when using hosted/local inference stacks (examples only):
# OPENAI_API_KEY=            # when VPI_EMBEDDING_PROVIDER=openai
# OLLAMA_HOST=               # when VPI_EMBEDDING_PROVIDER=ollama
