# ERL-QUAL-004 PostgreSQL lab configuration (non-production).
# Copy to postgres.env alongside this file and adjust for your machine:
#   cp infrastructure/config/postgres.env.example infrastructure/config/postgres.env

COMPOSE_PROJECT_NAME=erl-qual-004-postgres

POSTGRES_USER=erl_qual_004
POSTGRES_PASSWORD=change-me-local-lab-only
POSTGRES_DB=erl_qual_004

# Host port published on loopback only (see docker-compose.yml).
ERL_QUAL_004_POSTGRES_HOST_PORT=5435
