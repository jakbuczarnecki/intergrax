{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intergrax.enterprise_debt_exceptions_register.row.v0-draft",
  "title": "Enterprise Debt & Exceptions Register row (DRAFT, not adopted)",
  "description": "One row per debt item, evidence gap, pending decision or accepted exception. A row is a pointer plus status metadata; it never restates the canonical text, stage status or FRZ criterion status of its owner document.",
  "type": "object",
  "required": ["reg_id", "record_type", "register_class", "origin", "title", "owner_ref", "owner_status", "severity", "severity_source", "source_evidence",
               "baseline_sha", "current_head_status", "frz_arch_freeze_impact", "frz_impact_basis", "disposition", "next_track", "closure_condition",
               "reopen_condition", "needs_independent_audit", "needs_independent_audit_reason", "lifecycle_state"],
  "properties": {
    "reg_id": {"type": "string", "pattern": "^EDER-[FDXN]-[0-9]{4,}$", "description": "Immutable, never reused. F = ingested campaign finding, D = ingested register/ledger entry, X = exception recorded without a prior row, N = raised after ingest."},
    "record_type": {"enum": ["FINDING", "DEBT_ENTRY", "EXCEPTION"]},
    "register_class": {"enum": ["DEFECT", "ARCH_RISK", "GOVERNANCE_DEBT", "EVIDENCE_GAP", "CERT_DRIFT", "UNVERIFIED", "EXCEPTION_CANDIDATE", "DEBT", "DECISION_PENDING", "KNOWN_RED_TEST", "NA_DECISION", "SKIP_CATEGORY"], "description": "KNOWN_RED_TEST: a test known to fail, created only from an authorised bounded run (EQOA-A0-001). NA_DECISION: a recorded not-applicable decision or exception with its validity condition (EQOA-A0-002). SKIP_CATEGORY: a category of skip, xfail or no_ci markers, not one row per marker (EQOA-A7-037)."},
    "origin": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"enum": ["EQOA_FINDING", "A7_ENTRY", "NEW"]}, "id": {"type": "string"}, "entry_id": {"type": "string"}, "origin_register": {"type": "string"}, "dossier": {"type": "string"}}},
    "title": {"type": "string", "maxLength": 600, "description": "Label only; the canonical description lives in the cited source."},
    "owner_ref": {"type": ["string", "null"], "description": "ID in the owner vocabulary (stage, program, domain, FRZ family). Never free text, never a path. Null only while owner_status is MISSING/ROLE_NOT_OWNER/UNMAPPED/GENERIC_NOT_AN_OWNER."},
    "co_owner_refs": {"type": "array", "items": {"type": "string"}},
    "owner_status": {"enum": ["CONFIRMED", "SINGLE_PROPOSED", "SHARED_UNRESOLVED", "OPERATOR_ONLY", "MISSING", "ROLE_NOT_OWNER", "UNMAPPED", "GENERIC_NOT_AN_OWNER"]},
    "owner_raw": {"type": "string", "description": "Source text, kept for traceability."},
    "owner_stage_status": {"enum": ["CLOSED_CHECKED", "NOT_CLOSED_UNCHECKED", "NOT_A_ROADMAP_STAGE_ID", null]},
    "accountable_person": {"type": ["string", "null"], "description": "Assigned only by the Operator."},
    "severity": {"enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW", "INFO", "UNRATED"], "description": "UNRATED until the owner rates the row at triage; the register never infers a severity (EQOA-A7-034)."},
    "severity_source": {"enum": ["AUDIT_FINDING", "REGISTER_TOKEN", "OWNER_RATED", "NONE"]},
    "triage_priority": {"enum": ["P1", "P2", "P3", "P4"], "description": "Mechanical ordering aid derived from impact/severity; never a rating."},
    "source_evidence": {"type": "array", "items": {"type": "string", "pattern": "^([^ ]+@[0-9a-f]{40}(:[0-9]+)?|ws:.+)$"}},
    "source_evidence_narrative": {"type": "array", "items": {"type": "string"}},
    "baseline_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "snapshot_shas": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
    "current_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "current_head_status": {"enum": ["UNCHANGED", "CHANGED", "RESOLVED", "UNKNOWN"], "description": "UNCHANGED means the cited tracked paths are identical, not that the claim was re-verified. RESOLVED is only ever set with a closure_evidence record."},
    "current_head_evidence": {"type": "array", "items": {"type": "string"}},
    "frz_arch_freeze_impact": {"enum": ["BLOCKS", "CONDITIONS", "NONE", "UNKNOWN"]},
    "frz_impact_basis": {"type": "string"},
    "frz_refs": {"type": "array", "items": {"type": "string", "pattern": "^FRZ-[A-Z]+-[0-9]+(\\.\\.[0-9]+)?$"}},
    "disposition": {"enum": ["TRIAGE_PENDING", "CURRENCY_UNVERIFIED", "STALE_SNAPSHOT_REVERIFY", "DEFERRED_AS_STATED", "DEFERRED_AS_STATED_IMPACT_CLASS_REQUIRED", "DOC_PATCH_PENDING", "DECISION_PENDING", "VERIFICATION_PENDING", "FIX_PENDING_AFTER_PDC", "REQUALIFY_PENDING", "ACCEPTED_AS_STATED_RECORD_REQUIRED", "CLOSED_VERIFIED", "EXCEPTION_ACCEPTED", "SUPERSEDED", "WITHDRAWN_VERIFIED"], "description": "STALE_SNAPSHOT_REVERIFY: the source register is a snapshot that a source at the baseline contradicts; re-verify before closure (EQOA-A7-035)."},
    "next_track": {"enum": ["CODE_FIX", "DOC_PATCH", "DECISION", "VERIFY_TEST", "REQUALIFY", "ACCEPTED_LIMITATION", "UNCLASSIFIED"]},
    "secondary_tracks": {"type": "array", "items": {"enum": ["CODE_FIX", "DOC_PATCH", "DECISION", "VERIFY_TEST", "REQUALIFY", "ACCEPTED_LIMITATION"]}},
    "closure_condition": {"type": "string", "maxLength": 900},
    "closure_condition_basis": {"type": "string"},
    "reopen_condition": {"type": "string"},
    "reopen_condition_basis": {"type": "string"},
    "needs_independent_audit": {"enum": ["yes", "no", "tbd"]},
    "needs_independent_audit_reason": {"type": "string"},
    "lifecycle_state": {"enum": ["INGESTED", "TRIAGED", "PLANNED", "IN_PROGRESS", "VERIFYING", "CLOSED", "EXCEPTION_ACCEPTED", "SUPERSEDED", "WITHDRAWN", "REOPENED"]},
    "stale_flag": {"type": ["object", "null"]},
    "linked_finding_ids": {"type": "array", "items": {"type": "string"}},
    "linked_reg_ids": {"type": "array", "items": {"type": "string"}},
    "canonical_refs": {"type": "array", "items": {"type": "string"}, "description": "IDs only (stage, FRZ, ticket, decision record). No text."}
  },
  "allOf": [
    {"if": {"properties": {"lifecycle_state": {"enum": ["CLOSED", "EXCEPTION_ACCEPTED", "SUPERSEDED", "WITHDRAWN"]}}},
     "then": {"required": ["closure_evidence", "closed_at_sha", "closed_by", "reviewed_by"]}},
    {"if": {"properties": {"lifecycle_state": {"const": "EXCEPTION_ACCEPTED"}}},
     "then": {"required": ["acceptance_record", "accepting_authority", "exception_scope_ref", "review_by_or_reopen"], "properties": {"frz_arch_freeze_impact": {"enum": ["BLOCKS", "CONDITIONS", "NONE"]}}}},
    {"if": {"properties": {"needs_independent_audit": {"const": "yes"}, "lifecycle_state": {"const": "CLOSED"}}},
     "then": {"required": ["independent_audit_ref"]}},
    {"if": {"properties": {"lifecycle_state": {"enum": ["TRIAGED", "PLANNED", "IN_PROGRESS", "VERIFYING"]}}},
     "then": {"properties": {"severity": {"not": {"const": "UNRATED"}}, "frz_arch_freeze_impact": {"not": {"const": "UNKNOWN"}}, "next_track": {"not": {"const": "UNCLASSIFIED"}}, "owner_status": {"const": "CONFIRMED"}}}}
  ]
}
