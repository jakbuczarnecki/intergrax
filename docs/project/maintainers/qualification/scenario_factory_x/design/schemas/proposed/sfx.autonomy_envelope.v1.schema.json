{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sfx.autonomy_envelope.v1",
  "title": "AutonomyEnvelope",
  "description": "PROPOSED SFX R2. Bounded L2 scope; bound to DecisionBinding approval. Not an authority grant by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "mission_id",
    "goal_digest",
    "approval_ref",
    "max_iterations",
    "cost_budget",
    "deadline",
    "deny_egress",
    "canonical_digest"
  ],
  "properties": {
    "schema_version": { "const": "sfx.autonomy_envelope.v1" },
    "tenant_id": { "type": "string" },
    "mission_id": { "type": "string" },
    "goal_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "blueprint_digest_pin": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approval_ref": { "type": "string" },
    "delegation_grant_ref": { "type": "string" },
    "max_iterations": { "type": "integer", "minimum": 1 },
    "max_parallel_candidates": { "type": "integer", "minimum": 1, "default": 1 },
    "cost_budget": { "type": "object", "additionalProperties": false, "properties": { "currency": { "type": "string" }, "max_amount": { "type": "number", "minimum": 0 } } },
    "deadline": { "type": "string", "format": "date-time" },
    "allowed_asset_refs": { "type": "array", "items": { "type": "string" } },
    "deny_egress": { "const": true },
    "stop_on_stagnation_rounds": { "type": "integer", "minimum": 1 },
    "canonical_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}