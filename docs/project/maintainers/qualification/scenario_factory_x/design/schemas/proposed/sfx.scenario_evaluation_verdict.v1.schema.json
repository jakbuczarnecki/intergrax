{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sfx.scenario_evaluation_verdict.v1",
  "title": "ScenarioEvaluationVerdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "candidate_id",
    "run_id",
    "criteria",
    "overall",
    "canonical_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "sfx.scenario_evaluation_verdict.v1"
    },
    "mission_id": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "result"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "INSUFFICIENT_EVIDENCE",
              "BLOCKED_POLICY",
              "BLOCKED_ENVIRONMENT"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "overall": {
      "enum": [
        "PASS",
        "FAIL",
        "INSUFFICIENT_EVIDENCE",
        "BLOCKED_POLICY",
        "BLOCKED_ENVIRONMENT"
      ]
    },
    "canonical_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
