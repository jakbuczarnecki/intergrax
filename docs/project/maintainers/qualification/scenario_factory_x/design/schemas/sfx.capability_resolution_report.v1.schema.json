{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sfx.capability_resolution_report.v1",
  "title": "CapabilityResolutionReport",
  "description": "SFX-CON-04. Closed-world resolution of every specification requirement to existing platform capabilities. Input to G-1 and M-3. Envelope: canonical_digest = sha256(JCS(model_dump without canonical_digest)); see SFX_CANONICALIZATION.md. Persisted as a CW WorkArtifactVersion (ADR-SFX-002 §D5). Status: PROPOSED design draft (T-IGX-037-C); not code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "workspace_id",
    "work_item_id",
    "scenario_id",
    "artifact_id",
    "version",
    "canonical_digest",
    "created_at",
    "created_by",
    "specification_ref",
    "inventory_ref",
    "resolutions",
    "unresolved_count"
  ],
  "properties": {
    "schema_version": {
      "const": "sfx.capability_resolution_report.v1"
    },
    "tenant_id": {
      "$ref": "#/$defs/id"
    },
    "workspace_id": {
      "$ref": "#/$defs/id"
    },
    "work_item_id": {
      "$ref": "#/$defs/id"
    },
    "scenario_id": {
      "$ref": "#/$defs/id"
    },
    "artifact_id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1,
      "description": "SFX logical version; one CW WorkArtifactVersion per value."
    },
    "canonical_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "#/$defs/principal_ref"
    },
    "specification_ref": {
      "$ref": "#/$defs/artifact_version_ref"
    },
    "inventory_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_version",
        "inventory_digest"
      ],
      "properties": {
        "inventory_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]*$",
          "description": "Value of the top-level inventory_version string of the capability inventory file, copied verbatim (for example sfx-capability-inventory.v1+r1). Same as the opaque id pattern plus the + character."
        },
        "inventory_digest": {
          "$ref": "#/$defs/digest",
          "description": "sha256: followed by 64 zeros until SFX tooling computes the inventory digest."
        }
      },
      "description": "Closed-world inventory (reuse of CON-R-07 ClosedWorldInventory)."
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "capability_id",
          "resolution",
          "rationale",
          "evidence_ref"
        ],
        "properties": {
          "requirement_id": {
            "$ref": "#/$defs/id"
          },
          "capability_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "null"
              }
            ],
            "description": "Inventory row id (SFX-CAP-nn). For NEW_REQUIRED hosted scenario logic: the hosting row. Null when no row matches."
          },
          "resolution": {
            "enum": [
              "REUSE_AS_IS",
              "REUSE_WITH_CONFIGURATION",
              "EXTEND",
              "NEW_REQUIRED",
              "UNRESOLVED"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence_ref": {
            "anyOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "null"
              }
            ],
            "description": "Owner path with :line suffix, extracted from the inventory row code_path by the sfx-resolve rule. Null only when capability_id is null or the row has no owner path; a matched but UNRESOLVED row keeps its owner path."
          }
        }
      },
      "description": "Set semantics; sorted by requirement_id before canonicalization."
    },
    "unresolved_count": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 0
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "description": "Opaque identifier. Never a secret and never a free-text value."
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Platform content digest convention sha256:<64 lowercase hex> (intergrax/contracts/validation.py:13)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "description": "RFC 3339 UTC timestamp with exactly six fractional digits and a Z suffix (SFX_CANONICALIZATION.md, rule CF-5)."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64,
      "description": "Same pattern as SCENARIO_SLUG_PATTERN (scripts/proof/create_scenario_proof.py:19)."
    },
    "principal_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "actor_kind"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/id"
        },
        "actor_kind": {
          "enum": [
            "HUMAN",
            "AGENT",
            "SYSTEM"
          ],
          "description": "Kind of actor. G-2 counts only HUMAN actors."
        }
      },
      "description": "Harness principal reference."
    },
    "artifact_version_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "artifact_id",
        "version",
        "canonical_digest"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "pattern": "^sfx\\.[a-z_]+\\.v[0-9]+$"
        },
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "canonical_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "description": "Immutable reference to one SFX artifact version (CW WorkArtifactVersion)."
    },
    "secret_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]+$",
      "description": "Reference resolved by the credential broker at run time. Never a secret value."
    }
  }
}
