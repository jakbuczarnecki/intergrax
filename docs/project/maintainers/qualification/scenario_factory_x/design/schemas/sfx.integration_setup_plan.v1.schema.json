{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sfx.integration_setup_plan.v1",
  "title": "IntegrationSetupPlan",
  "description": "SFX-CON-06. Configuration of every integration the blueprint needs. Secrets appear only as secret_ref strings; configuration keys that name secrets are rejected. Envelope: canonical_digest = sha256(JCS(model_dump without canonical_digest)); see SFX_CANONICALIZATION.md. Persisted as a CW WorkArtifactVersion (ADR-SFX-002 §D5). Status: PROPOSED design draft (T-IGX-037-C); not code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "workspace_id",
    "work_item_id",
    "scenario_id",
    "artifact_id",
    "version",
    "canonical_digest",
    "created_at",
    "created_by",
    "blueprint_ref",
    "integrations"
  ],
  "properties": {
    "schema_version": {
      "const": "sfx.integration_setup_plan.v1"
    },
    "tenant_id": {
      "$ref": "#/$defs/id"
    },
    "workspace_id": {
      "$ref": "#/$defs/id"
    },
    "work_item_id": {
      "$ref": "#/$defs/id"
    },
    "scenario_id": {
      "$ref": "#/$defs/id"
    },
    "artifact_id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1,
      "description": "SFX logical version; one CW WorkArtifactVersion per value."
    },
    "canonical_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "#/$defs/principal_ref"
    },
    "blueprint_ref": {
      "$ref": "#/$defs/artifact_version_ref"
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "integration_id",
          "kind",
          "adapter_ref",
          "settings",
          "secret_refs",
          "network_egress",
          "prod_q_required"
        ],
        "properties": {
          "integration_id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "FIXTURE_ADAPTER",
              "STUB_HTTP",
              "LOCAL_VECTOR_STORE",
              "VENDOR_SANDBOX",
              "LIVE_VENDOR"
            ],
            "description": "LIVE_VENDOR is out of SFX scope and always sets prod_q_required."
          },
          "adapter_ref": {
            "$ref": "#/$defs/id"
          },
          "settings": {
            "type": "object",
            "description": "Non-secret settings only.",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "not": {
                "pattern": "(password|secret|token|apikey|api_key|credential|private_key)"
              }
            },
            "additionalProperties": {
              "type": [
                "string",
                "integer",
                "boolean"
              ],
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "secret_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "secret_ref"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "secret_ref": {
                  "$ref": "#/$defs/secret_ref"
                }
              }
            }
          },
          "network_egress": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "allowlist"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "DENY_ALL",
                  "ALLOWLIST"
                ]
              },
              "allowlist": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253
                }
              }
            },
            "description": "L2 requires DENY_ALL with an empty allowlist (master plan R1 §13)."
          },
          "prod_q_required": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "description": "Opaque identifier. Never a secret and never a free-text value."
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Platform content digest convention sha256:<64 lowercase hex> (intergrax/contracts/validation.py:13)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "description": "RFC 3339 UTC timestamp with exactly six fractional digits and a Z suffix (SFX_CANONICALIZATION.md, rule CF-5)."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64,
      "description": "Same pattern as SCENARIO_SLUG_PATTERN (scripts/proof/create_scenario_proof.py:19)."
    },
    "principal_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "actor_kind"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/id"
        },
        "actor_kind": {
          "enum": [
            "HUMAN",
            "AGENT",
            "SYSTEM"
          ],
          "description": "Kind of actor. G-2 counts only HUMAN actors."
        }
      },
      "description": "Harness principal reference."
    },
    "artifact_version_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "artifact_id",
        "version",
        "canonical_digest"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "pattern": "^sfx\\.[a-z_]+\\.v[0-9]+$"
        },
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "canonical_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "description": "Immutable reference to one SFX artifact version (CW WorkArtifactVersion)."
    },
    "secret_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]+$",
      "description": "Reference resolved by the credential broker at run time. Never a secret value."
    }
  }
}
