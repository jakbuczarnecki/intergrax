{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sfx.engineering_handoff_request.v1",
  "title": "EngineeringHandoffRequest",
  "description": "SFX-CON-08. Request to build the approved blueprint. DETERMINISTIC_SCAFFOLD runs the existing scaffold; AGENTIC_ENGINEERING prepares a SEF-X EngineeringIntent draft that only a human submits (HO-2; CON-N-01 'human submit only', governance/tickets/plans/ASF-SEF-MASTER-PLAN.md:381). Envelope: canonical_digest = sha256(JCS(model_dump without canonical_digest)); see SFX_CANONICALIZATION.md. Persisted as a CW WorkArtifactVersion (ADR-SFX-002 §D5). Status: PROPOSED design draft (T-IGX-037-C); not code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "workspace_id",
    "work_item_id",
    "scenario_id",
    "artifact_id",
    "version",
    "canonical_digest",
    "created_at",
    "created_by",
    "blueprint_ref",
    "blueprint_digest",
    "approval_ref",
    "mode",
    "workspace_path",
    "sef_intent_draft"
  ],
  "properties": {
    "schema_version": {
      "const": "sfx.engineering_handoff_request.v1"
    },
    "tenant_id": {
      "$ref": "#/$defs/id"
    },
    "workspace_id": {
      "$ref": "#/$defs/id"
    },
    "work_item_id": {
      "$ref": "#/$defs/id"
    },
    "scenario_id": {
      "$ref": "#/$defs/id"
    },
    "artifact_id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1,
      "description": "SFX logical version; one CW WorkArtifactVersion per value."
    },
    "canonical_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "#/$defs/principal_ref"
    },
    "blueprint_ref": {
      "$ref": "#/$defs/artifact_version_ref"
    },
    "blueprint_digest": {
      "$ref": "#/$defs/digest"
    },
    "approval_ref": {
      "$ref": "#/$defs/id"
    },
    "mode": {
      "enum": [
        "DETERMINISTIC_SCAFFOLD",
        "AGENTIC_ENGINEERING"
      ]
    },
    "workspace_path": {
      "type": "string",
      "pattern": "^applications/[a-z][a-z0-9_]*_scenario(_application)?/$"
    },
    "sef_intent_draft": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intent_id",
            "text_untrusted",
            "operator_id",
            "created_at"
          ],
          "properties": {
            "intent_id": {
              "$ref": "#/$defs/id"
            },
            "text_untrusted": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200000
            },
            "operator_id": {
              "$ref": "#/$defs/id"
            },
            "created_at": {
              "$ref": "#/$defs/timestamp"
            }
          },
          "description": "Draft modelled on CON-N-01 EngineeringIntent fields. text_untrusted contains the canonical blueprint and blueprint_digest. operator_id is the human approver who submits it; SFX never submits."
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "description": "Opaque identifier. Never a secret and never a free-text value."
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Platform content digest convention sha256:<64 lowercase hex> (intergrax/contracts/validation.py:13)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "description": "RFC 3339 UTC timestamp with exactly six fractional digits and a Z suffix (SFX_CANONICALIZATION.md, rule CF-5)."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64,
      "description": "Same pattern as SCENARIO_SLUG_PATTERN (scripts/proof/create_scenario_proof.py:19)."
    },
    "principal_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "actor_kind"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/id"
        },
        "actor_kind": {
          "enum": [
            "HUMAN",
            "AGENT",
            "SYSTEM"
          ],
          "description": "Kind of actor. G-2 counts only HUMAN actors."
        }
      },
      "description": "Harness principal reference."
    },
    "artifact_version_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "artifact_id",
        "version",
        "canonical_digest"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "pattern": "^sfx\\.[a-z_]+\\.v[0-9]+$"
        },
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "canonical_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "description": "Immutable reference to one SFX artifact version (CW WorkArtifactVersion)."
    },
    "secret_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]+$",
      "description": "Reference resolved by the credential broker at run time. Never a secret value."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "AGENTIC_ENGINEERING"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "sef_intent_draft": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "sef_intent_draft": {
            "type": "null"
          }
        }
      }
    }
  ]
}
