{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sfx.business_scenario_specification.v1",
  "title": "BusinessScenarioSpecification",
  "description": "SFX-CON-03. Validated business specification of one scenario. Deliberately not named ScenarioSpec, to avoid the collision with CON-R-06 ScenarioSpec_platform (governance/tickets/plans/ASF-SEF-MASTER-PLAN.md:360). Envelope: canonical_digest = sha256(JCS(model_dump without canonical_digest)); see SFX_CANONICALIZATION.md. Persisted as a CW WorkArtifactVersion (ADR-SFX-002 §D5). Status: PROPOSED design draft (T-IGX-037-C); not code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "workspace_id",
    "work_item_id",
    "scenario_id",
    "artifact_id",
    "version",
    "canonical_digest",
    "created_at",
    "created_by",
    "discovery_record_ref",
    "scenario_slug",
    "title",
    "objective",
    "actors",
    "inputs",
    "outputs",
    "business_rules",
    "decision_points",
    "integrations_required",
    "non_functional",
    "acceptance_criteria",
    "field_provenance",
    "authority_level_requested"
  ],
  "properties": {
    "schema_version": {
      "const": "sfx.business_scenario_specification.v1"
    },
    "tenant_id": {
      "$ref": "#/$defs/id"
    },
    "workspace_id": {
      "$ref": "#/$defs/id"
    },
    "work_item_id": {
      "$ref": "#/$defs/id"
    },
    "scenario_id": {
      "$ref": "#/$defs/id"
    },
    "artifact_id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1,
      "description": "SFX logical version; one CW WorkArtifactVersion per value."
    },
    "canonical_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "#/$defs/principal_ref"
    },
    "discovery_record_ref": {
      "$ref": "#/$defs/artifact_version_ref"
    },
    "scenario_slug": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor_id",
          "role",
          "kind"
        ],
        "properties": {
          "actor_id": {
            "$ref": "#/$defs/id"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "HUMAN",
              "SYSTEM",
              "AGENT"
            ]
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_id",
          "description",
          "data_classification"
        ],
        "properties": {
          "input_id": {
            "$ref": "#/$defs/id"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "data_classification": {
            "enum": [
              "PUBLIC",
              "INTERNAL",
              "CONFIDENTIAL",
              "RESTRICTED"
            ]
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "output_id",
          "description"
        ],
        "properties": {
          "output_id": {
            "$ref": "#/$defs/id"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "business_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "statement",
          "deterministic"
        ],
        "properties": {
          "rule_id": {
            "$ref": "#/$defs/id"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "deterministic": {
            "type": "boolean"
          }
        }
      }
    },
    "decision_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "description",
          "requires_human_approval"
        ],
        "properties": {
          "decision_id": {
            "$ref": "#/$defs/id"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "requires_human_approval": {
            "type": "boolean"
          }
        }
      }
    },
    "integrations_required": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "integration_id",
          "purpose",
          "direction"
        ],
        "properties": {
          "integration_id": {
            "$ref": "#/$defs/id"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "direction": {
            "enum": [
              "INBOUND",
              "OUTBOUND",
              "BIDIRECTIONAL"
            ]
          }
        }
      }
    },
    "non_functional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latency_p95_target_ms",
        "volume_per_day"
      ],
      "properties": {
        "latency_p95_target_ms": {
          "anyOf": [
            {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "volume_per_day": {
          "anyOf": [
            {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "statement",
          "measured_by"
        ],
        "properties": {
          "criterion_id": {
            "$ref": "#/$defs/id"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "measured_by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "minItems": 1
    },
    "field_provenance": {
      "type": "object",
      "description": "Provenance per top-level field (input to M-2).",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "enum": [
          "ANSWERED",
          "INFERRED",
          "DEFAULT",
          "MANUAL_EDIT"
        ]
      }
    },
    "authority_level_requested": {
      "enum": [
        "L0",
        "L1",
        "L2"
      ],
      "description": "Authority level (master plan R1 §7.10). L3 is never granted by SFX."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "description": "Opaque identifier. Never a secret and never a free-text value."
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Platform content digest convention sha256:<64 lowercase hex> (intergrax/contracts/validation.py:13)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "description": "RFC 3339 UTC timestamp with exactly six fractional digits and a Z suffix (SFX_CANONICALIZATION.md, rule CF-5)."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64,
      "description": "Same pattern as SCENARIO_SLUG_PATTERN (scripts/proof/create_scenario_proof.py:19)."
    },
    "principal_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "actor_kind"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/id"
        },
        "actor_kind": {
          "enum": [
            "HUMAN",
            "AGENT",
            "SYSTEM"
          ],
          "description": "Kind of actor. G-2 counts only HUMAN actors."
        }
      },
      "description": "Harness principal reference."
    },
    "artifact_version_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "artifact_id",
        "version",
        "canonical_digest"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "pattern": "^sfx\\.[a-z_]+\\.v[0-9]+$"
        },
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "canonical_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "description": "Immutable reference to one SFX artifact version (CW WorkArtifactVersion)."
    },
    "secret_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]+$",
      "description": "Reference resolved by the credential broker at run time. Never a secret value."
    }
  }
}
