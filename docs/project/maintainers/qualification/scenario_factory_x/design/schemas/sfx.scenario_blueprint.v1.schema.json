{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sfx.scenario_blueprint.v1",
  "title": "ScenarioBlueprint",
  "description": "SFX-CON-05. Approved composition of platform capabilities for one scenario. Its canonical_digest is the blueprint digest D_bp of the handoff. Not named ScenarioBuildPlan (CON-X-02). Envelope: canonical_digest = sha256(JCS(model_dump without canonical_digest)); see SFX_CANONICALIZATION.md. Persisted as a CW WorkArtifactVersion (ADR-SFX-002 §D5). Status: PROPOSED design draft (T-IGX-037-C); not code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "workspace_id",
    "work_item_id",
    "scenario_id",
    "artifact_id",
    "version",
    "canonical_digest",
    "created_at",
    "created_by",
    "specification_ref",
    "resolution_report_ref",
    "scenario_slug",
    "workspace_path",
    "capability_bindings",
    "agents",
    "tool_allowlist",
    "integration_plan_ref",
    "test_plan_ref",
    "authority_level",
    "environment_profile"
  ],
  "properties": {
    "schema_version": {
      "const": "sfx.scenario_blueprint.v1"
    },
    "tenant_id": {
      "$ref": "#/$defs/id"
    },
    "workspace_id": {
      "$ref": "#/$defs/id"
    },
    "work_item_id": {
      "$ref": "#/$defs/id"
    },
    "scenario_id": {
      "$ref": "#/$defs/id"
    },
    "artifact_id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1,
      "description": "SFX logical version; one CW WorkArtifactVersion per value."
    },
    "canonical_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "#/$defs/principal_ref"
    },
    "specification_ref": {
      "$ref": "#/$defs/artifact_version_ref"
    },
    "resolution_report_ref": {
      "$ref": "#/$defs/artifact_version_ref"
    },
    "scenario_slug": {
      "$ref": "#/$defs/slug"
    },
    "workspace_path": {
      "type": "string",
      "pattern": "^applications/[a-z][a-z0-9_]*_scenario(_application)?/$",
      "description": "Scenario workspace generated by the scaffold. The final suffix is open decision OQ-002-1 in ADR-SFX-002."
    },
    "capability_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_id",
          "requirement_id",
          "capability_id",
          "resolution",
          "configuration_ref"
        ],
        "properties": {
          "binding_id": {
            "$ref": "#/$defs/id"
          },
          "requirement_id": {
            "$ref": "#/$defs/id"
          },
          "capability_id": {
            "$ref": "#/$defs/id"
          },
          "resolution": {
            "enum": [
              "REUSE_AS_IS",
              "REUSE_WITH_CONFIGURATION",
              "EXTEND",
              "NEW_REQUIRED"
            ]
          },
          "configuration_ref": {
            "anyOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 1,
      "description": "Set semantics; sorted by binding_id. G-1 numerator: REUSE_AS_IS or REUSE_WITH_CONFIGURATION."
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "role",
          "lifecycle_state"
        ],
        "properties": {
          "agent_id": {
            "$ref": "#/$defs/id"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "lifecycle_state": {
            "enum": [
              "experimental",
              "development",
              "candidate",
              "staging"
            ],
            "description": "Never production (SFX-P9-02); values of AgentLifecycleState (intergrax/contracts/agent_lifecycle_state.py:10)."
          }
        }
      }
    },
    "tool_allowlist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "side_effect"
        ],
        "properties": {
          "tool_id": {
            "$ref": "#/$defs/id"
          },
          "side_effect": {
            "enum": [
              "NONE",
              "READ",
              "WRITE"
            ]
          }
        }
      },
      "description": "Explicit allowlist; sorted by tool_id."
    },
    "integration_plan_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact_version_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "test_plan_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact_version_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_level": {
      "enum": [
        "L0",
        "L1",
        "L2"
      ],
      "description": "Authority level (master plan R1 §7.10). L3 is never granted by SFX."
    },
    "environment_profile": {
      "const": "LAB"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "description": "Opaque identifier. Never a secret and never a free-text value."
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Platform content digest convention sha256:<64 lowercase hex> (intergrax/contracts/validation.py:13)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "description": "RFC 3339 UTC timestamp with exactly six fractional digits and a Z suffix (SFX_CANONICALIZATION.md, rule CF-5)."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64,
      "description": "Same pattern as SCENARIO_SLUG_PATTERN (scripts/proof/create_scenario_proof.py:19)."
    },
    "principal_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "actor_kind"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/id"
        },
        "actor_kind": {
          "enum": [
            "HUMAN",
            "AGENT",
            "SYSTEM"
          ],
          "description": "Kind of actor. G-2 counts only HUMAN actors."
        }
      },
      "description": "Harness principal reference."
    },
    "artifact_version_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "artifact_id",
        "version",
        "canonical_digest"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "pattern": "^sfx\\.[a-z_]+\\.v[0-9]+$"
        },
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "canonical_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "description": "Immutable reference to one SFX artifact version (CW WorkArtifactVersion)."
    },
    "secret_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]+$",
      "description": "Reference resolved by the credential broker at run time. Never a secret value."
    }
  }
}
