{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sfx.scenario_qualification_record.v1",
  "title": "ScenarioQualificationRecord",
  "description": "SFX-CON-16. Sandbox qualification result of one generated package. SANDBOX_CERTIFIED requires a verifier distinct from the implementer. It certifies nothing for production (SFX-INV-01). Envelope: canonical_digest = sha256(JCS(model_dump without canonical_digest)); see SFX_CANONICALIZATION.md. Persisted as a CW WorkArtifactVersion (ADR-SFX-002 §D5). Status: PROPOSED design draft (T-IGX-037-C); not code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "workspace_id",
    "work_item_id",
    "scenario_id",
    "artifact_id",
    "version",
    "canonical_digest",
    "created_at",
    "created_by",
    "package",
    "blueprint_digest",
    "engineering_job_ref",
    "measurement_sha",
    "qualification_level",
    "checks",
    "verdict",
    "implementer",
    "verifier",
    "evidence_bundle_digest",
    "limitations",
    "certifies_production"
  ],
  "properties": {
    "schema_version": {
      "const": "sfx.scenario_qualification_record.v1"
    },
    "tenant_id": {
      "$ref": "#/$defs/id"
    },
    "workspace_id": {
      "$ref": "#/$defs/id"
    },
    "work_item_id": {
      "$ref": "#/$defs/id"
    },
    "scenario_id": {
      "$ref": "#/$defs/id"
    },
    "artifact_id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1,
      "description": "SFX logical version; one CW WorkArtifactVersion per value."
    },
    "canonical_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "#/$defs/principal_ref"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "package_version",
        "package_checksum"
      ],
      "properties": {
        "package_id": {
          "$ref": "#/$defs/id"
        },
        "package_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "package_checksum": {
          "$ref": "#/$defs/digest"
        }
      },
      "description": "ApplicationPackage identity (intergrax/applications/contracts/application_package.py:56). The checksum must be non-empty, unlike the platform default (application_package.py:52)."
    },
    "blueprint_digest": {
      "$ref": "#/$defs/digest"
    },
    "engineering_job_ref": {
      "$ref": "#/$defs/artifact_version_ref"
    },
    "measurement_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "qualification_level": {
      "enum": [
        "SANDBOX_TESTED",
        "SANDBOX_CERTIFIED"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "evidence_ref"
        ],
        "properties": {
          "check_id": {
            "enum": [
              "HO-1",
              "HO-2",
              "HO-3",
              "HO-4",
              "HO-5",
              "HO-6",
              "HO-7",
              "ARCHITECTURE_CONFORMANCE",
              "TEST_PLAN",
              "SAST",
              "DEPENDENCY_AUDIT",
              "WORKSPACE_ISOLATION",
              "NETWORK_RESTRICTION",
              "SAFE_TOOLS",
              "NO_SELF_ESCALATION"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_APPLICABLE",
              "BLOCKED"
            ]
          },
          "evidence_ref": {
            "anyOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 1,
      "description": "Sorted by check_id."
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "implementer": {
      "$ref": "#/$defs/principal_ref"
    },
    "verifier": {
      "anyOf": [
        {
          "$ref": "#/$defs/principal_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_bundle_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "certifies_production": {
      "const": false
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "description": "Opaque identifier. Never a secret and never a free-text value."
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Platform content digest convention sha256:<64 lowercase hex> (intergrax/contracts/validation.py:13)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "description": "RFC 3339 UTC timestamp with exactly six fractional digits and a Z suffix (SFX_CANONICALIZATION.md, rule CF-5)."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64,
      "description": "Same pattern as SCENARIO_SLUG_PATTERN (scripts/proof/create_scenario_proof.py:19)."
    },
    "principal_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "actor_kind"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/id"
        },
        "actor_kind": {
          "enum": [
            "HUMAN",
            "AGENT",
            "SYSTEM"
          ],
          "description": "Kind of actor. G-2 counts only HUMAN actors."
        }
      },
      "description": "Harness principal reference."
    },
    "artifact_version_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "artifact_id",
        "version",
        "canonical_digest"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "pattern": "^sfx\\.[a-z_]+\\.v[0-9]+$"
        },
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "canonical_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "description": "Immutable reference to one SFX artifact version (CW WorkArtifactVersion)."
    },
    "secret_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]+$",
      "description": "Reference resolved by the credential broker at run time. Never a secret value."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "qualification_level": {
            "const": "SANDBOX_CERTIFIED"
          }
        },
        "required": [
          "qualification_level"
        ]
      },
      "then": {
        "properties": {
          "verifier": {
            "$ref": "#/$defs/principal_ref"
          }
        },
        "description": "verifier.principal_id must differ from implementer.principal_id (checked by the service; not expressible in JSON Schema)."
      }
    }
  ]
}
