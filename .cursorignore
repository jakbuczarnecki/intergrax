# Cursor indexing exclusions  —  reduce noise and token waste.
# Agents can still Read/run paths explicitly when needed (tests, RESUME audit runs).

# Python / build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
build/
dist/
wheels/
*.egg-info/

# Virtual env & secrets
.venv/
.env
.env.*

# VCS / IDE
.git/
.idea/
.vscode/

# Large or generated runtime artifacts
uv.lock
build/agent_fleet_inventory.json
**/node_modules/

# Test caches and bulky fixtures
tests/**/__snapshots__/
tests/**/fixtures/**/*.jsonl
tests/**/fixtures/**/*.parquet
tests/**/fixtures/**/*.bin
tests/**/fixtures/**/*.pdf
tests/**/fixtures/**/*.zip
tests/**/data/**/*.db
tests/**/data/**/*.sqlite

# External / temp content
_external_apps/
docs/_external/
temp_documents/

# Historical audit runs (use RESUME path explicitly)
docs/audit_results/

# Audit control prompts — explicit @ / Read only
docs/project/maintainers/audit/

# ADR archive (load cited ADR only)
docs/project/technical/adr/entries/

# Implementation journal archive
docs/project/maintainers/implementation-journal/entries/

# Bulky agent test fixtures
agents/**/tests/fixtures/**
agents/**/tests/**/snapshots/

# LLM crawler maps (hub docs suffice)
llms-full.txt

# Architecture / plan satellites  —  hub read-scope + explicit Read/@ only (F4 / G1)
docs/project/architecture/satellites/
docs/project/maintainers/plans/satellites/
docs/project/capabilities/architecture/satellites/
docs/project/capabilities/plan/satellites/

# Bulky guides  —  load with explicit @ / Read only (H2)
docs/project/technical/guides/AGENT_CREATION_GUIDE.md
docs/project/technical/guides/APPLICATION_CREATION_GUIDE.md
docs/project/technical/guides/INTEGRAX_HARNESS_AUDIT_MAP.md
docs/project/technical/guides/IDEAL_HARNESS_AI_ARCHITECTURE.md
docs/project/technical/guides/HARNESS_IMPLEMENTATION_AUDIT_PROMPT.md
docs/project/technical/guides/SYSTEM_INVARIANTS.md
docs/project/technical/guides/MATURITY_TAXONOMY.md
docs/project/technical/guides/INTERGRAX_DEVELOPMENT_STRATEGY.md
docs/project/architecture/intergrax_runtime_architecture.md
docs/project/maintainers/plans/AUDIT_IDEAL_2026.md