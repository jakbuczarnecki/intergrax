# Copy to .env for local overrides (optional).
COMPOSE_PROJECT_NAME=intergrax

POSTGRES_USER=intergrax
POSTGRES_PASSWORD=intergrax
POSTGRES_DB=intergrax

RABBITMQ_DEFAULT_USER=intergrax
RABBITMQ_DEFAULT_PASS=intergrax

MINIO_ROOT_USER=intergrax
MINIO_ROOT_PASSWORD=intergrax

VAULT_DEV_ROOT_TOKEN_ID=intergrax-dev-token
VAULT_DEV_LISTEN_ADDRESS=0.0.0.0:8200

NEO4J_AUTH=neo4j/intergrax

# vLLM (profile vllm — NVIDIA GPU required)
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_EMBED_MODEL=BAAI/bge-small-en-v1.5
VLLM_USE_V1=0
# HUGGING_FACE_HUB_TOKEN=   # optional, for gated models

# llama.cpp (profile llama-cpp — CPU-friendly)
LLAMA_CPP_HF_MODEL=bartowski/Llama-3.2-1B-Instruct-GGUF:Llama-3.2-1B-Instruct-Q4_K_M.gguf
LLAMA_CPP_EMBED_HF_MODEL=nomic-ai/nomic-embed-text-v1.5-GGUF:Q4_K_M.gguf
