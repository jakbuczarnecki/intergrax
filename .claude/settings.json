{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "plansDirectory": "agent-env/plans",
  "permissions": {
    "ask": [
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git switch --detach *)",
      "Bash(git checkout --detach *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)"
    ]
  }
}
