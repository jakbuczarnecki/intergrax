#!/bin/sh
# Intergrax pre-push enterprise gate (smoke by default). Install: scripts/dev/install_git_hooks.py
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
if ! command -v uv >/dev/null 2>&1; then
  case "$(uname -s 2>/dev/null)" in
    MINGW* | MSYS* | CYGWIN*)
      _uv_bin="${HOME}/.local/bin"
      if [ ! -x "${_uv_bin}/uv.exe" ] && [ ! -x "${_uv_bin}/uv" ] && [ -n "${USERPROFILE}" ]; then
        if command -v cygpath >/dev/null 2>&1; then
          _uv_bin="$(cygpath -u "${USERPROFILE}")/.local/bin"
        else
          _uv_bin="${USERPROFILE}/.local/bin"
        fi
      fi
      if [ -x "${_uv_bin}/uv.exe" ] || [ -x "${_uv_bin}/uv" ]; then
        PATH="${_uv_bin}:${PATH}"
        export PATH
      fi
      ;;
  esac
fi
if ! command -v uv >/dev/null 2>&1; then
  echo "pre-push: uv not found on PATH (install Astral uv or add %USERPROFILE%\\.local\\bin)" >&2
  exit 127
fi
exec uv run python -u scripts/ci/run_push_gate.py
