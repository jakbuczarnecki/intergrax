#
# Linux Docker runtime certification image for LKW (PROOF-PORTABILITY-1D).
# Build from monorepo root:
#   docker build -f applications/local_workspace_application/docker/Dockerfile.linux-certification \
#     --ignorefile applications/local_workspace_application/docker/.dockerignore \
#     -t intergrax-lkw-linux-certification .
#
# Base image digest (pin): sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b
# Resolved from docker.io/library/python:3.12-slim-bookworm at certification authoring time.

FROM python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b

LABEL org.opencontainers.image.title="intergrax-lkw-linux-certification" \
      org.opencontainers.image.description="LKW Linux Docker runtime certification proof image"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONPATH=/app:/app/agents:/app/applications \
    INTERGRAX_ENV=dev \
    LOCAL_WORKSPACE_BACKEND_ENV=dev \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:/usr/local/bin:$PATH"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/0.7.12/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/uv \
    && chmod 755 /usr/local/bin/uv \
    && useradd --create-home --uid 10001 --shell /bin/sh lkwcert

COPY pyproject.toml uv.lock README.md ./
COPY intergrax/ ./intergrax/
COPY applications/ ./applications/
COPY agents/local_indexer/ ./agents/local_indexer/
COPY agents/local_search/ ./agents/local_search/
COPY agents/local_synthesizer/ ./agents/local_synthesizer/

# Application project selects Intergrax extras (incl. MongoDB).
# Certification group adds pytest for in-image proof runners.
# Normalize POSIX shell scripts to LF (Windows checkouts may use CRLF).
RUN uv sync --frozen --no-dev --project applications/local_workspace_application --group certification \
    && find applications/local_workspace_application/scripts -name '*.sh' -print0 \
        | xargs -0 sed -i 's/\r$//' \
    && chown -R lkwcert:lkwcert /app

ENV PATH="/app/.venv/bin:/usr/local/bin:$PATH"

USER lkwcert
WORKDIR /app

# Default command is overridden by certification Compose / orchestrator.
CMD ["python", "applications/local_workspace_application/scripts/run-lkw-linux-container-certification-inside.py"]
