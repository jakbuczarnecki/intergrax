# LOCAL_WORKSPACE_* — copy to .env (gitignored) in this application directory.
INTERGRAX_ENV=dev
LOCAL_WORKSPACE_BACKEND_ENV=dev
LOCAL_WORKSPACE_BACKEND_HOST=127.0.0.1
LOCAL_WORKSPACE_BACKEND_PORT=8020
LOCAL_WORKSPACE_ROUTE_PREFIX=/v1/local_workspace
LOCAL_WORKSPACE_DEFAULT_AGENT_ID=local_search
LOCAL_WORKSPACE_IDENTITY_SOURCE=body_or_context
LOCAL_WORKSPACE_INCLUDE_MCP=true
LOCAL_WORKSPACE_MCP_MOUNT_PATH=/mcp
LOCAL_WORKSPACE_INCLUDE_TASK_CONTROL=true
LOCAL_WORKSPACE_TASK_CONTROL_ROUTE_PREFIX=/v1/tasks
# LOCAL_WORKSPACE_INCLUDE_SCHEDULER=false
# LOCAL_WORKSPACE_INCLUDE_INTERACTIONS=false

# RAG (local document index)
LOCAL_WORKSPACE_ENABLE_RAG=true
LOCAL_WORKSPACE_ENABLE_RAG_INGEST=true

# Shadow workspace root (agent artifacts — not user home)
# INTERGRAX_SHADOW_ROOT=build/shadow_workspaces

# Optional dev API key (prod requires keys or ALLOW_UNAUTHENTICATED=true):
# LOCAL_WORKSPACE_BACKEND_BOOTSTRAP_API_KEY=dev-key
# LOCAL_WORKSPACE_BACKEND_BOOTSTRAP_TENANT_ID=dev-tenant
# LOCAL_WORKSPACE_BACKEND_BOOTSTRAP_USER_ID=dev-user

# Example capabilities for POST /v1/local_workspace/run:
#   local.workspace.index
#   local.workspace.search
#   local.workspace.synthesize
