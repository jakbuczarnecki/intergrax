# LOCAL_WORKSPACE_* - copy to .env (gitignored) in this application directory.
# Application settings use the LOCAL_WORKSPACE_* prefix.
# Platform INTERGRAX_* catalog: docs/project/technical/guides/PLATFORM_CONFIGURATION.md

# =============================================================================
# Application configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Application runtime environment (dev, test, stage, prod)
LOCAL_WORKSPACE_BACKEND_ENV=dev

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
# Bind address for the application HTTP server
LOCAL_WORKSPACE_BACKEND_HOST=127.0.0.1
# TCP port for the application HTTP server
LOCAL_WORKSPACE_BACKEND_PORT=8020
# URL prefix for this application's HTTP routes
LOCAL_WORKSPACE_ROUTE_PREFIX=/v1/local_workspace

# -----------------------------------------------------------------------------
# Agents
# -----------------------------------------------------------------------------
# Default agent id when a request does not name one
LOCAL_WORKSPACE_DEFAULT_AGENT_ID=local_search

# -----------------------------------------------------------------------------
# Identity
# -----------------------------------------------------------------------------
# Where the API reads caller identity (body_or_context or context_only)
LOCAL_WORKSPACE_IDENTITY_SOURCE=body_or_context

# -----------------------------------------------------------------------------
# Local data home
# -----------------------------------------------------------------------------
# Canonical LKW data root. Derived layout: config/, data/, logs/, run/
LOCAL_WORKSPACE_DATA_HOME=build/local_workspace

# -----------------------------------------------------------------------------
# RAG
# -----------------------------------------------------------------------------
# Enable RAG retrieval on this application
LOCAL_WORKSPACE_ENABLE_RAG=true
# Enable RAG document ingest on this application
LOCAL_WORKSPACE_ENABLE_RAG_INGEST=true
# Vector store integration slug for this application
LOCAL_WORKSPACE_VECTOR_STORE=qdrant

# -----------------------------------------------------------------------------
# Cache / queue
# -----------------------------------------------------------------------------
# Enable Redis-backed cache/queue layer (keep false until background ingest needs it)
LOCAL_WORKSPACE_ENABLE_REDIS=false

# -----------------------------------------------------------------------------
# HTTP surfaces
# -----------------------------------------------------------------------------
# Mount the MCP server on the same process as this application
LOCAL_WORKSPACE_INCLUDE_MCP=true
# HTTP path where the MCP server is mounted when enabled
LOCAL_WORKSPACE_MCP_MOUNT_PATH=/mcp
# Expose task-control HTTP routes on this application
LOCAL_WORKSPACE_INCLUDE_TASK_CONTROL=true
# URL prefix for task-control routes
LOCAL_WORKSPACE_TASK_CONTROL_ROUTE_PREFIX=/v1/tasks
# Run the in-process scheduler with this application
# LOCAL_WORKSPACE_INCLUDE_SCHEDULER=false
# Expose interaction HTTP routes on this application
# LOCAL_WORKSPACE_INCLUDE_INTERACTIONS=false

# -----------------------------------------------------------------------------
# Slack Ask companion (LKW product workflow)
# -----------------------------------------------------------------------------
# Enable the LKW Slack Ask companion workflow
LOCAL_WORKSPACE_SLACK_COMPANION_ENABLED=false
# Slack workspace/team id allowed to use the companion (format: T...)
LOCAL_WORKSPACE_SLACK_APPROVED_TEAM_ID=
# Slack user id allowed to send Ask messages (format: U...)
LOCAL_WORKSPACE_SLACK_APPROVED_USER_ID=
# LKW tenant that owns the configured workspace
LOCAL_WORKSPACE_SLACK_TENANT_ID=
# LKW workspace id with synchronized/indexed evidence
LOCAL_WORKSPACE_SLACK_ACTIVE_WORKSPACE_ID=
# Base URL of the running LKW HTTP host
LOCAL_WORKSPACE_SLACK_ASK_BASE_URL=http://127.0.0.1:8020/
# Optional API key passed as X-API-Key to the LKW Ask endpoint
LOCAL_WORKSPACE_SLACK_ASK_API_KEY=
# Ask request timeout in seconds (no automatic retry)
LOCAL_WORKSPACE_SLACK_ASK_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# API authentication
# -----------------------------------------------------------------------------
# Optional dev API key (prod requires keys or ALLOW_UNAUTHENTICATED=true)
# LOCAL_WORKSPACE_BACKEND_BOOTSTRAP_API_KEY=dev-key
# LOCAL_WORKSPACE_BACKEND_BOOTSTRAP_TENANT_ID=dev-tenant
# LOCAL_WORKSPACE_BACKEND_BOOTSTRAP_USER_ID=dev-user

# -----------------------------------------------------------------------------
# Observability export
# -----------------------------------------------------------------------------
# Enable observability export from this application
LOCAL_WORKSPACE_OBSERVABILITY_EXPORT_ENABLED=false
# Observability export backend (otlp, elasticsearch, or sentry)
LOCAL_WORKSPACE_OBSERVABILITY_EXPORT_BACKEND=otlp
# OTLP logs endpoint for observability export
LOCAL_WORKSPACE_OBSERVABILITY_OTLP_ENDPOINT=http://otel-collector:4318/v1/logs
# Service name reported by observability export
LOCAL_WORKSPACE_OBSERVABILITY_SERVICE_NAME=intergrax-lkw
# Service version reported by observability export
LOCAL_WORKSPACE_OBSERVABILITY_SERVICE_VERSION=dev
# Deployment environment label for observability export
LOCAL_WORKSPACE_OBSERVABILITY_ENVIRONMENT=dev
# Export raw content in observability records (policy-safe metadata only when false)
LOCAL_WORKSPACE_OBSERVABILITY_EXPORT_CONTENT=false
# OTLP export request timeout in seconds
LOCAL_WORKSPACE_OBSERVABILITY_OTLP_TIMEOUT_SECONDS=30
# Elasticsearch/OpenSearch URL for observability export
LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_URL=
# Elasticsearch index name for observability export
LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_INDEX=intergrax-lkw-observability
# Elasticsearch request timeout in seconds
LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_TIMEOUT_SECONDS=30
# Enable retry for failed Elasticsearch deliveries
LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_RETRY_ENABLED=true
# Maximum Elasticsearch delivery retry attempts
LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_RETRY_MAX_ATTEMPTS=3
# Initial Elasticsearch retry backoff in seconds
LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_RETRY_INITIAL_BACKOFF_SECONDS=0.25
# Maximum Elasticsearch retry backoff in seconds
LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_RETRY_MAX_BACKOFF_SECONDS=2.0
# JSONL file path for failed Elasticsearch delivery diagnostics
LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_FAILED_DELIVERY_FILE_PATH=
# Sentry DSN observability proof uses docker-compose.sentry.yml overlay
# LOCAL_WORKSPACE_OBSERVABILITY_EXPORT_BACKEND=sentry
# LOCAL_WORKSPACE_OBSERVABILITY_SENTRY_DSN=
# LOCAL_WORKSPACE_OBSERVABILITY_SENTRY_ENVIRONMENT=local-proof
# LOCAL_WORKSPACE_OBSERVABILITY_SENTRY_RELEASE=lkw-sentry-proof
# LOCAL_WORKSPACE_OBSERVABILITY_SENTRY_SERVER_NAME=intergrax-lkw-local
# LOCAL_WORKSPACE_OBSERVABILITY_SENTRY_SHUTDOWN_TIMEOUT_SECONDS=2
# LOCAL_WORKSPACE_OBSERVABILITY_SENTRY_FLUSH_AFTER_CAPTURE=true

# Example capabilities for POST /v1/local_workspace/run:
#   local.workspace.index
#   local.workspace.search
#   local.workspace.synthesize

# =============================================================================
# Platform configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Shared platform runtime environment (dev, test, stage, prod)
INTERGRAX_ENV=dev

# -----------------------------------------------------------------------------
# File access
# -----------------------------------------------------------------------------
# Comma-separated absolute paths the platform may read for indexing
# Use absolute host paths for local uvicorn runs.
# Docker compose overrides this to /data/user_docs inside the container.
INTERGRAX_ALLOWED_READ_ROOTS=
# INTERGRAX_ALLOWED_READ_ROOTS=/absolute/path/to/docs,/absolute/path/to/projects

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# SQLite data directory for platform databases
INTERGRAX_SQLITE_DATA_DIR=build/local_workspace/data/sqlite
# Shadow workspace root for sandboxed file operations
INTERGRAX_SHADOW_ROOT=build/local_workspace/data/shadow_workspaces

# -----------------------------------------------------------------------------
# Vector store
# -----------------------------------------------------------------------------
# Qdrant HTTP endpoint for vector storage
INTERGRAX_QDRANT_URL=http://localhost:6333
# Qdrant collection name for this application's index
INTERGRAX_QDRANT_COLLECTION=local_workspace

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# Embedding provider for RAG vectorization
INTERGRAX_EMBEDDING_PROVIDER=ollama
# Embedding model id for RAG vectorization
INTERGRAX_EMBEDDING_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# Generation LLM
# -----------------------------------------------------------------------------
# LLM provider for generation (local-first default: ollama)
INTERGRAX_LLM_PROVIDER=ollama
# LLM model id for generation
INTERGRAX_LLM_MODEL=llama3.1:latest
# Ollama HTTP endpoint
# OLLAMA_HOST=http://localhost:11434
# Optional OpenAI-compatible inference server (vLLM example)
# INTERGRAX_LLM_PROVIDER=vllm
# INTERGRAX_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# INTERGRAX_DEFAULT_VLLM_BASE_URL=http://localhost:8000/v1

# -----------------------------------------------------------------------------
# Cache / queue
# -----------------------------------------------------------------------------
# Redis connection URL for platform cache/queue
# INTERGRAX_REDIS_URL=redis://localhost:6379/0
# Redis logical database index
# INTERGRAX_REDIS_DB=0
# Redis key prefix for LKW namespacing
# INTERGRAX_REDIS_KEY_PREFIX=lkw:

# -----------------------------------------------------------------------------
# Slack transport
# -----------------------------------------------------------------------------
# Enable Slack Socket Mode conversation transport (platform layer)
INTERGRAX_SLACK_CONVERSATION_ENABLED=true
# Slack app-level token (xapp-, scope: connections:write)
INTERGRAX_SLACK_APP_TOKEN=
# Slack bot OAuth token (xoxb-, scopes: chat:write, im:history)
INTERGRAX_SLACK_BOT_TOKEN=
# Slack API request timeout in seconds
INTERGRAX_SLACK_API_TIMEOUT_SECONDS=30
# Slack live-proof timeout in seconds
INTERGRAX_SLACK_PROOF_TIMEOUT_SECONDS=180

# -----------------------------------------------------------------------------
# Proof receipts (Compose overlay)
# -----------------------------------------------------------------------------
# Local MongoDB stack for PROOF-RECEIPTS-1D (docker-compose.mongodb.yml only)
# LKW_MONGODB_ROOT_USERNAME=intergrax
# LKW_MONGODB_ROOT_PASSWORD=intergrax-local-dev-only
# LKW_MONGODB_DATABASE=intergrax_proofs
# LKW_MONGODB_COLLECTION=proof_receipts
# LKW_MONGODB_HOST_PORT=27018
# LKW_MONGO_EXPRESS_PORT=8086
# INTERGRAX_MONGODB_URI=mongodb://intergrax:intergrax-local-dev-only@lkw-mongodb:27017/intergrax_proofs?authSource=admin
# INTERGRAX_MONGODB_DATABASE=intergrax_proofs
# INTERGRAX_MONGODB_COLLECTION=proof_receipts
