# LOCAL_WORKSPACE_* — copy to .env (gitignored) in this application directory.

# Runtime mode
INTERGRAX_ENV=dev
LOCAL_WORKSPACE_BACKEND_ENV=dev
LOCAL_WORKSPACE_BACKEND_HOST=127.0.0.1
LOCAL_WORKSPACE_BACKEND_PORT=8020
LOCAL_WORKSPACE_ROUTE_PREFIX=/v1/local_workspace
LOCAL_WORKSPACE_DEFAULT_AGENT_ID=local_search
LOCAL_WORKSPACE_IDENTITY_SOURCE=body_or_context

# Local user-file access. Required before indexing real files.
# Use absolute host paths for local uvicorn runs.
# Docker compose overrides this to /data/user_docs inside the container.
# INTERGRAX_ALLOWED_READ_ROOTS=/absolute/path/to/docs,/absolute/path/to/projects

# Local persistence
INTERGRAX_SQLITE_DATA_DIR=build/local_workspace/sqlite
INTERGRAX_SHADOW_ROOT=build/local_workspace/shadow_workspaces

# RAG local document index
LOCAL_WORKSPACE_ENABLE_RAG=true
LOCAL_WORKSPACE_ENABLE_RAG_INGEST=true
LOCAL_WORKSPACE_VECTOR_STORE=qdrant
INTERGRAX_QDRANT_URL=http://localhost:6333
INTERGRAX_QDRANT_COLLECTION=local_workspace

# Optional cache/queue layer. Keep false until background ingest / queue work requires Redis.
LOCAL_WORKSPACE_ENABLE_REDIS=false
# INTERGRAX_REDIS_URL=redis://localhost:6379/0
# INTERGRAX_REDIS_DB=0
# INTERGRAX_REDIS_KEY_PREFIX=lkw:

# Local LLM. Ollama is the default local-first provider.
INTERGRAX_LLM_PROVIDER=ollama
INTERGRAX_LLM_MODEL=llama3.1:latest
INTERGRAX_DEFAULT_OLLAMA_MODEL=llama3.1:latest
# OLLAMA_HOST=http://localhost:11434

# Optional advanced local OpenAI-compatible inference server.
# INTERGRAX_LLM_PROVIDER=vllm
# INTERGRAX_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# INTERGRAX_DEFAULT_VLLM_BASE_URL=http://localhost:8000/v1
# INTERGRAX_DEFAULT_VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# HTTP/MCP surfaces
LOCAL_WORKSPACE_INCLUDE_MCP=true
LOCAL_WORKSPACE_MCP_MOUNT_PATH=/mcp
LOCAL_WORKSPACE_INCLUDE_TASK_CONTROL=true
LOCAL_WORKSPACE_TASK_CONTROL_ROUTE_PREFIX=/v1/tasks
# LOCAL_WORKSPACE_INCLUDE_SCHEDULER=false
# LOCAL_WORKSPACE_INCLUDE_INTERACTIONS=false

# Optional dev API key (prod requires keys or ALLOW_UNAUTHENTICATED=true):
# LOCAL_WORKSPACE_BACKEND_BOOTSTRAP_API_KEY=dev-key
# LOCAL_WORKSPACE_BACKEND_BOOTSTRAP_TENANT_ID=dev-tenant
# LOCAL_WORKSPACE_BACKEND_BOOTSTRAP_USER_ID=dev-user

# Example capabilities for POST /v1/local_workspace/run:
#   local.workspace.index
#   local.workspace.search
#   local.workspace.synthesize

INTERGRAX_ALLOWED_READ_ROOTS=

# Observability export (optional; disabled by default for manual/non-compose runs)
# Local Docker Compose enables OTLP export explicitly and starts otel-collector.
# The optional docker-compose.elasticsearch.yml overlay switches the backend to elasticsearch.
# Exported data are policy-sanitized observability records. Raw content is not exported.
LOCAL_WORKSPACE_OBSERVABILITY_EXPORT_ENABLED=false
LOCAL_WORKSPACE_OBSERVABILITY_EXPORT_BACKEND=otlp
LOCAL_WORKSPACE_OBSERVABILITY_OTLP_ENDPOINT=http://otel-collector:4318/v1/logs
LOCAL_WORKSPACE_OBSERVABILITY_SERVICE_NAME=intergrax-lkw
LOCAL_WORKSPACE_OBSERVABILITY_SERVICE_VERSION=dev
LOCAL_WORKSPACE_OBSERVABILITY_ENVIRONMENT=dev
LOCAL_WORKSPACE_OBSERVABILITY_EXPORT_CONTENT=false
LOCAL_WORKSPACE_OBSERVABILITY_OTLP_TIMEOUT_SECONDS=30

# Elasticsearch/OpenSearch-compatible observability backend.
# For local Docker Compose overlay use:
#   LOCAL_WORKSPACE_OBSERVABILITY_EXPORT_BACKEND=elasticsearch
#   LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_URL=http://elasticsearch:9200
# For local uvicorn against a host-exposed backend use http://localhost:9200.
LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_URL=
LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_INDEX=intergrax-lkw-observability
LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_TIMEOUT_SECONDS=30

LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_RETRY_ENABLED=true
LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_RETRY_MAX_ATTEMPTS=3
LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_RETRY_INITIAL_BACKOFF_SECONDS=0.25
LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_RETRY_MAX_BACKOFF_SECONDS=2.0

# Optional JSONL file for safe Elasticsearch failed-delivery diagnostics.
# Leave empty to disable. Point to a controlled runtime/app data directory.
# Example: applications/local_workspace_application/.observability/elasticsearch/failed-deliveries.jsonl
LOCAL_WORKSPACE_OBSERVABILITY_ELASTICSEARCH_FAILED_DELIVERY_FILE_PATH=
# Sentry observability proof - canonical path is local Docker Compose overlay
# (docker-compose.sentry.yml). Do not commit real external DSNs.
# Sentry receives policy-safe metadata only; raw content export remains disabled.
# External SaaS DSN override (optional advanced use only):
# LOCAL_WORKSPACE_OBSERVABILITY_EXPORT_BACKEND=sentry
# LOCAL_WORKSPACE_OBSERVABILITY_SENTRY_DSN=
# LOCAL_WORKSPACE_OBSERVABILITY_SENTRY_ENVIRONMENT=local-proof
# LOCAL_WORKSPACE_OBSERVABILITY_SENTRY_RELEASE=lkw-sentry-proof
# LOCAL_WORKSPACE_OBSERVABILITY_SENTRY_SERVER_NAME=intergrax-lkw-local
# LOCAL_WORKSPACE_OBSERVABILITY_SENTRY_SHUTDOWN_TIMEOUT_SECONDS=2
# LOCAL_WORKSPACE_OBSERVABILITY_SENTRY_FLUSH_AFTER_CAPTURE=true
