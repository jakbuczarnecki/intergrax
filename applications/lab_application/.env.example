# LAB_* - copy to .env (gitignored) in this application directory.
# Application settings use the LAB_* prefix.
# Platform INTERGRAX_* catalog: docs/project/technical/guides/PLATFORM_CONFIGURATION.md

# =============================================================================
# Application configuration
# =============================================================================

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
# Bind address for the application HTTP server
LAB_BACKEND_HOST=127.0.0.1
# TCP port for the application HTTP server
LAB_BACKEND_PORT=8090
# URL prefix for this application's HTTP routes
LAB_ROUTE_PREFIX=/v1/lab

# -----------------------------------------------------------------------------
# Lab features
# -----------------------------------------------------------------------------
# Mount the echo agent on the lab harness
LAB_INCLUDE_ECHO=true
# Mount mock agents for integration testing
LAB_INCLUDE_MOCK_AGENTS=true
# Mount the signoff probe agent
LAB_INCLUDE_SIGNOFF_PROBE=true
# Mount the research agent preset
LAB_INCLUDE_RESEARCH=false
# Mount the problem radar agent preset
LAB_INCLUDE_PROBLEM_RADAR=false
# Enable strict harness mode (production_mode + governance + trace_db_path)
# LAB_STRICT_HARNESS=true

# -----------------------------------------------------------------------------
# Interactions
# -----------------------------------------------------------------------------
# Expose interaction HTTP routes on this application
LAB_INCLUDE_INTERACTIONS=true
# URL prefix for interaction routes
LAB_INTERACTION_ROUTE_PREFIX=/v1/interactions
# Interaction UI/API surface to mount (auto selects the default)
LAB_INTERACTION_SURFACE=auto

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
# Mount the MCP server on the same process as this application
LAB_INCLUDE_MCP=false
# HTTP path where the MCP server is mounted when enabled
LAB_MCP_MOUNT_PATH=/mcp

# -----------------------------------------------------------------------------
# Background workers
# -----------------------------------------------------------------------------
# Run the in-process scheduler with this application
LAB_INCLUDE_SCHEDULER=true

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Enable OTEL observability facade on the lab harness preset
# LAB_OTEL_ENABLED=true

# =============================================================================
# Platform configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Shared platform runtime environment (dev, test, stage, prod)
INTERGRAX_ENV=dev

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# When set, lab/debug/MCP routes require X-Api-Key or Bearer
# INTERGRAX_HARNESS_API_KEY=change-me

# -----------------------------------------------------------------------------
# Background workers
# -----------------------------------------------------------------------------
# Scheduler poll interval in seconds
# INTERGRAX_SCHEDULER_POLL_SECONDS=30

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# Optional per-task KV memory database (UAEP / debug API)
# INTERGRAX_TASK_MEMORY_DB=build/lab_task_memory.db

# -----------------------------------------------------------------------------
# Metrics
# -----------------------------------------------------------------------------
# Enable LLM call metrics collection
# INTERGRAX_LLM_METRICS_ENABLED=true
# Enable RAG metrics collection
# INTERGRAX_RAG_METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# OTLP collector endpoint for lab observability export
# INTERGRAX_OTEL_ENDPOINT=http://localhost:4318
# Service name reported to the OTLP collector
# INTERGRAX_OTEL_SERVICE_NAME=intergrax-lab
