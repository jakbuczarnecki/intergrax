# LAB_* — copy to .env (gitignored) in this application directory.
# Platform LLM/embedding: ../../docs/project/technical/guides/PLATFORM_CONFIGURATION.md
INTERGRAX_ENV=dev
LAB_BACKEND_HOST=127.0.0.1
LAB_BACKEND_PORT=8090
LAB_ROUTE_PREFIX=/v1/lab
LAB_INCLUDE_ECHO=true
LAB_INCLUDE_MOCK_AGENTS=true
LAB_INCLUDE_SIGNOFF_PROBE=true
LAB_INCLUDE_RESEARCH=false
LAB_INCLUDE_PROBLEM_RADAR=false
LAB_INCLUDE_INTERACTIONS=true
LAB_INTERACTION_ROUTE_PREFIX=/v1/interactions
LAB_INCLUDE_SCHEDULER=true
LAB_INTERACTION_SURFACE=auto
LAB_INCLUDE_MCP=false
# INTERGRAX_HARNESS_API_KEY=change-me   # when set, lab/debug/MCP require X-Api-Key or Bearer
# LAB_STRICT_HARNESS=true               # production_mode + governance + trace_db_path on agents
LAB_MCP_MOUNT_PATH=/mcp
# INTERGRAX_SCHEDULER_POLL_SECONDS=30
# Optional per-task KV memory (UAEP / debug API)
# INTERGRAX_TASK_MEMORY_DB=build/lab_task_memory.db
# INTERGRAX_LLM_METRICS_ENABLED=true
# INTERGRAX_RAG_METRICS_ENABLED=true
# Phase S — OTEL observability facade (noop exporter unless collector reachable)
# LAB_OTEL_ENABLED=true   # default on; set false to disable OTEL on lab harness preset
# INTERGRAX_OTEL_ENDPOINT=http://localhost:4318
# INTERGRAX_OTEL_SERVICE_NAME=intergrax-lab
