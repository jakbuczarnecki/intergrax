# LEGAL_* — copy to .env (gitignored) in this application directory.
INTERGRAX_ENV=dev
# Optional UAEP task memory (SQLite)
# INTERGRAX_TASK_MEMORY_DB=build/legal_task_memory.db
LEGAL_BACKEND_HOST=0.0.0.0
LEGAL_BACKEND_PORT=8000
LEGAL_BACKEND_ENV=dev
LEGAL_ROUTE_PREFIX=/v1/legal
LEGAL_PRODUCT_PROFILE=strict_legal
LEGAL_LLM_PROVIDER=ollama
# LEGAL_LLM_MODEL=llama3.1:latest
LEGAL_DEFAULT_AGENT_ID=legal-default
LEGAL_IDENTITY_SOURCE=body_or_context
# LEGAL_BACKEND_CORS_ORIGINS=http://localhost:3000
# LEGAL_BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1
# LEGAL_SESSION_SQLITE_PATH=build/legal_sessions.db
# Dev bootstrap (do not commit real keys):
# LEGAL_BACKEND_BOOTSTRAP_API_KEY=dev-key-change-me
# LEGAL_BACKEND_BOOTSTRAP_TENANT_ID=tenant-dev
# LEGAL_BACKEND_BOOTSTRAP_USER_ID=user-dev
LEGAL_INCLUDE_MCP=true
LEGAL_MCP_MOUNT_PATH=/mcp
LEGAL_INCLUDE_INTERACTIONS=true
LEGAL_INCLUDE_TASK_CONTROL=true
LEGAL_INCLUDE_SCHEDULER=true
LEGAL_INCLUDE_QUEUE_WORKER=false
LEGAL_TASK_CONTROL_ROUTE_PREFIX=/v1/tasks
LEGAL_INTERACTION_ROUTE_PREFIX=/v1/interactions
LEGAL_INTERACTION_SURFACE=auto
# LEGAL_INTERACTION_EXECUTE_DEFAULT=true
# Tool catalog (Phase O) — enable catalog tools on RuntimeConfig
# LEGAL_ENABLE_RAG=false
# LEGAL_ENABLE_RAG_INGEST=false
# LEGAL_ENABLE_WEBSEARCH=false
# LEGAL_USE_TOOL_DECISION=false
# LEGAL_TOOLS_MODE=off
# LEGAL_ENABLED_TOOLS=jira.search_tasks
# Optional LLM guardrails (Integration category llm_guardrail — M.12)
# LEGAL_ENABLE_LLM_GUARDRAILS=false
# LEGAL_LLM_GUARDRAIL_PRIMARY=llm_guard
# LEGAL_LLM_GUARDRAIL_SEMANTIC=presidio
# INTERGRAX_LAKERA_API_KEY=
# INTERGRAX_LAKERA_BASE_URL=
# INTERGRAX_OPENGUARDRAILS_API_KEY=
# INTERGRAX_OPENGUARDRAILS_BASE_URL=
# INTERGRAX_AZURE_CONTENT_SAFETY_API_KEY=
# INTERGRAX_AZURE_CONTENT_SAFETY_BASE_URL=
# INTERGRAX_NEMO_COLANG_CONFIG_PATH=
# INTERGRAX_BEDROCK_GUARDRAIL_POLICY_ID=
# Integration profile overrides (see repo-root .env.example)
# INTERGRAX_INTEGRATION_DOCUMENT_PARSER=docling
# INTERGRAX_INTEGRATION_RERANK_PROVIDER=cohere_rerank
# Research SKU (LEGAL_PRODUCT_PROFILE=research) enables RAG/websearch/tool-decision by default
