# LEGAL_* - copy to .env (gitignored) in this application directory.
# Application settings use the LEGAL_* prefix.
# Platform INTERGRAX_* catalog: docs/project/technical/guides/PLATFORM_CONFIGURATION.md

# =============================================================================
# Application configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Application runtime environment (dev, test, stage, prod)
LEGAL_BACKEND_ENV=dev
# Legal product profile (strict_legal or research)
LEGAL_PRODUCT_PROFILE=strict_legal

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
# Bind address for the application HTTP server
LEGAL_BACKEND_HOST=0.0.0.0
# TCP port for the application HTTP server
LEGAL_BACKEND_PORT=8000
# URL prefix for this application's HTTP routes
LEGAL_ROUTE_PREFIX=/v1/legal

# -----------------------------------------------------------------------------
# Agents
# -----------------------------------------------------------------------------
# Default agent id when a request does not name one
LEGAL_DEFAULT_AGENT_ID=legal-default
# Application-level LLM provider override
LEGAL_LLM_PROVIDER=ollama
# Application-level LLM model override
# LEGAL_LLM_MODEL=llama3.1:latest

# -----------------------------------------------------------------------------
# Identity
# -----------------------------------------------------------------------------
# Where the API reads caller identity (body_or_context or context_only)
LEGAL_IDENTITY_SOURCE=body_or_context

# -----------------------------------------------------------------------------
# Interactions
# -----------------------------------------------------------------------------
# Expose interaction HTTP routes on this application
LEGAL_INCLUDE_INTERACTIONS=true
# URL prefix for interaction routes
LEGAL_INTERACTION_ROUTE_PREFIX=/v1/interactions
# Interaction UI/API surface to mount (auto selects the default)
LEGAL_INTERACTION_SURFACE=auto
# Enable interaction execute by default on this application
# LEGAL_INTERACTION_EXECUTE_DEFAULT=true

# -----------------------------------------------------------------------------
# Task control
# -----------------------------------------------------------------------------
# Expose task-control HTTP routes on this application
LEGAL_INCLUDE_TASK_CONTROL=true
# URL prefix for task-control routes
LEGAL_TASK_CONTROL_ROUTE_PREFIX=/v1/tasks

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
# Mount the MCP server on the same process as this application
LEGAL_INCLUDE_MCP=true
# HTTP path where the MCP server is mounted when enabled
LEGAL_MCP_MOUNT_PATH=/mcp

# -----------------------------------------------------------------------------
# Background workers
# -----------------------------------------------------------------------------
# Run the in-process scheduler with this application
LEGAL_INCLUDE_SCHEDULER=true
# Run the in-process queue worker with this application
LEGAL_INCLUDE_QUEUE_WORKER=false

# -----------------------------------------------------------------------------
# HTTP security
# -----------------------------------------------------------------------------
# Comma-separated CORS origins allowed by this application
# LEGAL_BACKEND_CORS_ORIGINS=http://localhost:3000
# Comma-separated Host headers this application accepts
# LEGAL_BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# API authentication
# -----------------------------------------------------------------------------
# Dev bootstrap API key (do not commit real keys)
# LEGAL_BACKEND_BOOTSTRAP_API_KEY=dev-key-change-me
# LEGAL_BACKEND_BOOTSTRAP_TENANT_ID=tenant-dev
# LEGAL_BACKEND_BOOTSTRAP_USER_ID=user-dev

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# SQLite path for legal session storage
# LEGAL_SESSION_SQLITE_PATH=build/legal_sessions.db

# -----------------------------------------------------------------------------
# Tools / RAG
# -----------------------------------------------------------------------------
# Enable RAG tools on the runtime tool catalog
# LEGAL_ENABLE_RAG=false
# Enable RAG ingest tools on the runtime tool catalog
# LEGAL_ENABLE_RAG_INGEST=false
# Enable web search tools on the runtime tool catalog
# LEGAL_ENABLE_WEBSEARCH=false
# Enable LLM tool-decision routing
# LEGAL_USE_TOOL_DECISION=false
# Tool catalog mode (off, allowlist, or full)
# LEGAL_TOOLS_MODE=off
# Comma-separated allowlist of enabled tool ids
# LEGAL_ENABLED_TOOLS=jira.search_tasks

# -----------------------------------------------------------------------------
# LLM guardrails (application)
# -----------------------------------------------------------------------------
# Enable application-level LLM guardrails (M.12)
# LEGAL_ENABLE_LLM_GUARDRAILS=false
# Primary guardrail integration slug
# LEGAL_LLM_GUARDRAIL_PRIMARY=llm_guard
# Secondary semantic guardrail integration slug
# LEGAL_LLM_GUARDRAIL_SEMANTIC=presidio

# =============================================================================
# Platform configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Shared platform runtime environment (dev, test, stage, prod)
INTERGRAX_ENV=dev

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# Optional per-task KV memory database (SQLite)
# INTERGRAX_TASK_MEMORY_DB=build/legal_task_memory.db

# -----------------------------------------------------------------------------
# LLM guardrails (platform providers)
# -----------------------------------------------------------------------------
# INTERGRAX_LAKERA_API_KEY=
# INTERGRAX_LAKERA_BASE_URL=
# INTERGRAX_OPENGUARDRAILS_API_KEY=
# INTERGRAX_OPENGUARDRAILS_BASE_URL=
# INTERGRAX_AZURE_CONTENT_SAFETY_API_KEY=
# INTERGRAX_AZURE_CONTENT_SAFETY_BASE_URL=
# INTERGRAX_NEMO_COLANG_CONFIG_PATH=
# INTERGRAX_BEDROCK_GUARDRAIL_POLICY_ID=

# -----------------------------------------------------------------------------
# Integration profiles
# -----------------------------------------------------------------------------
# See repo-root .env.example for INTERGRAX_INTEGRATION_* overrides
# INTERGRAX_INTEGRATION_DOCUMENT_PARSER=docling
# INTERGRAX_INTEGRATION_RERANK_PROVIDER=cohere_rerank
# Research SKU (LEGAL_PRODUCT_PROFILE=research) enables RAG/websearch/tool-decision by default
