# GOVERNED_CONTRACTOR_* - copy to .env (gitignored) in this application directory.
# Application settings use the GOVERNED_CONTRACTOR_* prefix.
# Platform INTERGRAX_* catalog: docs/project/technical/guides/PLATFORM_CONFIGURATION.md

# =============================================================================
# Application configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Application runtime environment (dev, test, stage, prod)
GOVERNED_CONTRACTOR_BACKEND_ENV=dev

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
# Bind address for the application HTTP server
GOVERNED_CONTRACTOR_BACKEND_HOST=127.0.0.1
# TCP port for the application HTTP server
GOVERNED_CONTRACTOR_BACKEND_PORT=8000
# URL prefix for this application's HTTP routes
GOVERNED_CONTRACTOR_ROUTE_PREFIX=/v1/governed_contractor

# -----------------------------------------------------------------------------
# Agents
# -----------------------------------------------------------------------------
# Default agent id when a request does not name one
GOVERNED_CONTRACTOR_DEFAULT_AGENT_ID=external_contractor_adapter

# -----------------------------------------------------------------------------
# Identity
# -----------------------------------------------------------------------------
# Where the API reads caller identity (body_or_context or context_only)
GOVERNED_CONTRACTOR_IDENTITY_SOURCE=body_or_context

# -----------------------------------------------------------------------------
# Interactions
# -----------------------------------------------------------------------------
# Expose interaction HTTP routes on this application
GOVERNED_CONTRACTOR_INCLUDE_INTERACTIONS=true
# URL prefix for interaction routes
GOVERNED_CONTRACTOR_INTERACTION_ROUTE_PREFIX=/v1/interactions
# Interaction UI/API surface to mount (auto selects the default)
GOVERNED_CONTRACTOR_INTERACTION_SURFACE=auto

# -----------------------------------------------------------------------------
# Task control
# -----------------------------------------------------------------------------
# Expose task-control HTTP routes on this application
GOVERNED_CONTRACTOR_INCLUDE_TASK_CONTROL=true
# URL prefix for task-control routes
GOVERNED_CONTRACTOR_TASK_CONTROL_ROUTE_PREFIX=/v1/tasks

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
# Mount the MCP server on the same process as this application
GOVERNED_CONTRACTOR_INCLUDE_MCP=false
# HTTP path where the MCP server is mounted when enabled
GOVERNED_CONTRACTOR_MCP_MOUNT_PATH=/mcp

# -----------------------------------------------------------------------------
# Background workers
# -----------------------------------------------------------------------------
# Run the in-process scheduler with this application
GOVERNED_CONTRACTOR_INCLUDE_SCHEDULER=false
# Run the in-process queue worker with this application
GOVERNED_CONTRACTOR_INCLUDE_QUEUE_WORKER=true

# -----------------------------------------------------------------------------
# API authentication
# -----------------------------------------------------------------------------
# Optional dev API key (prod requires keys or ALLOW_UNAUTHENTICATED=true)
# GOVERNED_CONTRACTOR_BACKEND_BOOTSTRAP_API_KEY=dev-key
# GOVERNED_CONTRACTOR_BACKEND_BOOTSTRAP_TENANT_ID=dev-tenant
# GOVERNED_CONTRACTOR_BACKEND_BOOTSTRAP_USER_ID=dev-user

# Example capability for POST /v1/governed_contractor/run
# DEFAULT_CAPABILITY=external_contractor_adapter.basic

# =============================================================================
# Platform configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Shared platform runtime environment (dev, test, stage, prod)
INTERGRAX_ENV=dev
