# Copy to intergrax-gca-docker-local-qualification.env (same directory; gitignored locally).
# LOCAL QUALIFICATION ONLY — not production acceptance or Linux VM TARGET-VERIFIED profile.

INTERGRAX_SINGLE_NODE_PRODUCTION_V1_DATA_DIR=/var/lib/intergrax/production-v1/data
INTERGRAX_SINGLE_NODE_PRODUCTION_V1_SERVICE_RUNTIME_USER=intergrax-gca
INTERGRAX_SINGLE_NODE_PRODUCTION_V1_ENFORCE_SINGLE_ACTIVE_WRITER=1
INTERGRAX_SINGLE_NODE_PRODUCTION_V1_TRUSTED_ARTIFACT_PARENT_ROOTS=/var/lib/intergrax/production-v1/data/trusted_artifacts

GOVERNED_CONTRACTOR_BACKEND_ENV=prod

# Optional: override base image tag after build_application_image.py
# INTERGRAX_GCA_QUALIFICATION_BASE_IMAGE=governed_contractor-application:latest

# Package B operator serve (required for strict serving — not supplied by this project):
# INTERGRAX_GCA_STRICT_SERVE_EXEC='python -m operator.gca_strict_serve'

# Strict production credentials and governance bundles are operator-supplied (out-of-repo).
# INTERGRAX_OPERATOR_PRODUCTION_MUTATION_POLICY_BUNDLE_ID=
# GOVERNED_CONTRACTOR_BACKEND_API_KEYS_JSON=
