# Copy to /etc/intergrax/intergrax-gca-strict-production.env (root:root 0640).
# Values are examples — operator must supply authorized paths on the target VM.

INTERGRAX_SINGLE_NODE_PRODUCTION_V1_DATA_DIR=/var/lib/intergrax/production-v1/data
INTERGRAX_SINGLE_NODE_PRODUCTION_V1_SERVICE_RUNTIME_USER=intergrax-gca
INTERGRAX_SINGLE_NODE_PRODUCTION_V1_ENFORCE_SINGLE_ACTIVE_WRITER=1
INTERGRAX_SINGLE_NODE_PRODUCTION_V1_TRUSTED_ARTIFACT_PARENT_ROOTS=/var/lib/intergrax/production-v1/trusted_artifacts

GOVERNED_CONTRACTOR_BACKEND_ENV=prod

# Strict production credentials and governance bundles are operator-supplied (out-of-repo).
# INTERGRAX_OPERATOR_PRODUCTION_MUTATION_POLICY_BUNDLE_ID=
# GOVERNED_CONTRACTOR_BACKEND_API_KEYS_JSON=
