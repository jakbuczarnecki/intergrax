# Attestation demo - environment template (copy to repo .env or export)
# Application settings use the ATTESTATION_DEMO_* prefix.
# Platform INTERGRAX_* catalog: docs/project/technical/guides/PLATFORM_CONFIGURATION.md

# =============================================================================
# Application configuration
# =============================================================================

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
# Bind address for the application HTTP server
ATTESTATION_DEMO_BACKEND_HOST=127.0.0.1
# TCP port for the application HTTP server
ATTESTATION_DEMO_BACKEND_PORT=8097
# URL prefix for this application's HTTP routes
ATTESTATION_DEMO_ROUTE_PREFIX=/v1/attestation_demo

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
# Mount the MCP server on the same process as this application
ATTESTATION_DEMO_INCLUDE_MCP=false

# -----------------------------------------------------------------------------
# Interactions
# -----------------------------------------------------------------------------
# Expose interaction HTTP routes on this application
ATTESTATION_DEMO_INCLUDE_INTERACTIONS=false

# -----------------------------------------------------------------------------
# Background workers
# -----------------------------------------------------------------------------
# Run the in-process scheduler with this application
ATTESTATION_DEMO_INCLUDE_SCHEDULER=false

# =============================================================================
# Platform configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Require X-Api-Key / Bearer on POST /poc/run (recommended for partner deploy)
# INTERGRAX_HARNESS_API_KEY=change-me-before-sharing

# -----------------------------------------------------------------------------
# EBE host signing
# -----------------------------------------------------------------------------
# 32-byte Ed25519 seed (base64 or hex). Dev PoC seed in partner_handoff/ebe9_golden_vector.v1.json
# INTERGRAX_EBE_HOST_SIGNING_KEY=
# Public key id label for host signing
# INTERGRAX_EBE_HOST_SIGNING_PUBLIC_KEY_ID=attestation-demo-host-1
