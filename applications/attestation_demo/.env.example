# Attestation demo — environment template (copy to repo .env or export)

ATTESTATION_DEMO_BACKEND_HOST=127.0.0.1
ATTESTATION_DEMO_BACKEND_PORT=8097
ATTESTATION_DEMO_ROUTE_PREFIX=/v1/attestation_demo
ATTESTATION_DEMO_INCLUDE_MCP=false
ATTESTATION_DEMO_INCLUDE_SCHEDULER=false
ATTESTATION_DEMO_INCLUDE_INTERACTIONS=false

# Optional — require X-Api-Key / Bearer on POST /poc/run (recommended for partner deploy)
# INTERGRAX_HARNESS_API_KEY=change-me-before-sharing
