# INTERGRAX_ASSISTANT_* - copy to .env (gitignored) in this application directory.
# Application settings use the INTERGRAX_ASSISTANT_* prefix.
# Platform INTERGRAX_* catalog: docs/project/technical/guides/PLATFORM_CONFIGURATION.md

# =============================================================================
# Application configuration
# =============================================================================

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
# Bind address for the application HTTP server
INTERGRAX_ASSISTANT_BACKEND_HOST=127.0.0.1
# TCP port for the application HTTP server
INTERGRAX_ASSISTANT_BACKEND_PORT=8096
# URL prefix for this application's HTTP routes
INTERGRAX_ASSISTANT_ROUTE_PREFIX=/v1/intergrax_assistant

# -----------------------------------------------------------------------------
# Interactions
# -----------------------------------------------------------------------------
# Expose interaction HTTP routes on this application
INTERGRAX_ASSISTANT_INCLUDE_INTERACTIONS=true
# Interaction UI/API surface to mount (auto selects the default)
INTERGRAX_ASSISTANT_INTERACTION_SURFACE=auto

# -----------------------------------------------------------------------------
# Task control
# -----------------------------------------------------------------------------
# Expose task-control HTTP routes on this application
INTERGRAX_ASSISTANT_INCLUDE_TASK_CONTROL=true
# URL prefix for task-control routes
INTERGRAX_ASSISTANT_TASK_CONTROL_ROUTE_PREFIX=/v1/harness/tasks

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
# Mount the MCP server on the same process as this application
INTERGRAX_ASSISTANT_INCLUDE_MCP=true
# HTTP path where the MCP server is mounted when enabled
INTERGRAX_ASSISTANT_MCP_MOUNT_PATH=/mcp

# -----------------------------------------------------------------------------
# Background workers
# -----------------------------------------------------------------------------
# Run the in-process scheduler with this application
INTERGRAX_ASSISTANT_INCLUDE_SCHEDULER=true

# -----------------------------------------------------------------------------
# Specialist roster
# -----------------------------------------------------------------------------
# Mount the echo specialist agent
INTERGRAX_ASSISTANT_INCLUDE_ECHO=false
# Mount the legal specialist agent
INTERGRAX_ASSISTANT_INCLUDE_LEGAL=false
# Mount the research specialist agent
INTERGRAX_ASSISTANT_INCLUDE_RESEARCH=false
# Maximum specialist delegation depth
INTERGRAX_ASSISTANT_MAX_DELEGATION_DEPTH=4
# Enable LLM engine planner for dynamic specialist delegation
INTERGRAX_ASSISTANT_ENGINE_PLANNER=false

# Example run capability for POST /v1/intergrax_assistant/run
# DEFAULT_CAPABILITY=platform.assist

# =============================================================================
# Platform configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Shared platform runtime environment (dev, test, stage, prod)
INTERGRAX_ENV=dev

# -----------------------------------------------------------------------------
# Generation LLM
# -----------------------------------------------------------------------------
# LLM provider for generation (local-first default: ollama)
INTERGRAX_LLM_PROVIDER=ollama
# LLM model id for generation
INTERGRAX_LLM_MODEL=llama3.1:latest
# Cloud example:
# INTERGRAX_LLM_PROVIDER=openai
# INTERGRAX_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Plugins
# -----------------------------------------------------------------------------
# Discover external plugin catalogs at startup (lab recipe)
# INTERGRAX_DISCOVER_PLUGINS=true
