# INTERGRAX_ASSISTANT_* — copy to .env (gitignored) in this application directory.
INTERGRAX_ENV=dev
INTERGRAX_ASSISTANT_BACKEND_HOST=127.0.0.1
INTERGRAX_ASSISTANT_BACKEND_PORT=8096
INTERGRAX_ASSISTANT_ROUTE_PREFIX=/v1/intergrax_assistant
INTERGRAX_ASSISTANT_INCLUDE_INTERACTIONS=true
INTERGRAX_ASSISTANT_INCLUDE_SCHEDULER=true
INTERGRAX_ASSISTANT_INCLUDE_TASK_CONTROL=true
INTERGRAX_ASSISTANT_TASK_CONTROL_ROUTE_PREFIX=/v1/harness/tasks
INTERGRAX_ASSISTANT_INTERACTION_SURFACE=auto
INTERGRAX_ASSISTANT_INCLUDE_MCP=true
INTERGRAX_ASSISTANT_MCP_MOUNT_PATH=/mcp

# Swappable LLM adapter (local-first default: Ollama)
INTERGRAX_LLM_PROVIDER=ollama
INTERGRAX_LLM_MODEL=llama3.1:latest
# Cloud example:
# INTERGRAX_LLM_PROVIDER=openai
# INTERGRAX_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Optional platform specialist roster (hub agent always mounted)
INTERGRAX_ASSISTANT_INCLUDE_ECHO=false
INTERGRAX_ASSISTANT_INCLUDE_LEGAL=false
INTERGRAX_ASSISTANT_INCLUDE_RESEARCH=false
INTERGRAX_ASSISTANT_MAX_DELEGATION_DEPTH=4
# Enable LLM engine planner for dynamic specialist delegation (requires working LLM)
INTERGRAX_ASSISTANT_ENGINE_PLANNER=false

# External plugin catalogs (lab recipe)
# INTERGRAX_DISCOVER_PLUGINS=true

# Example run capability for POST /v1/intergrax_assistant/run
# DEFAULT_CAPABILITY=platform.assist
