# RESEARCH_* - copy to .env (gitignored) in this application directory.
# Application settings use the RESEARCH_* prefix.
# Platform INTERGRAX_* catalog: docs/project/technical/guides/PLATFORM_CONFIGURATION.md

# =============================================================================
# Application configuration
# =============================================================================

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
# Bind address for the application HTTP server
RESEARCH_BACKEND_HOST=0.0.0.0
# TCP port for the application HTTP server
RESEARCH_BACKEND_PORT=8010
# URL prefix for this application's HTTP routes
RESEARCH_ROUTE_PREFIX=/v1/research
# Enable uvicorn auto-reload (development only)
# RESEARCH_BACKEND_RELOAD=false

# -----------------------------------------------------------------------------
# Agent engine
# -----------------------------------------------------------------------------
# Use the Nexus loop agent engine instead of the legacy engine
RESEARCH_USE_NEXUS_LOOP=true
# Use the legacy agent engine instead of Nexus
# RESEARCH_USE_LEGACY_AGENT_ENGINE=false

# -----------------------------------------------------------------------------
# Interactions
# -----------------------------------------------------------------------------
# Expose interaction HTTP routes on this application
RESEARCH_INCLUDE_INTERACTIONS=true
# URL prefix for interaction routes
RESEARCH_INTERACTION_ROUTE_PREFIX=/v1/interactions
# Interaction UI/API surface to mount (auto selects the default)
RESEARCH_INTERACTION_SURFACE=auto

# -----------------------------------------------------------------------------
# Task control
# -----------------------------------------------------------------------------
# Expose task-control HTTP routes on this application
RESEARCH_INCLUDE_TASK_CONTROL=true
# URL prefix for task-control routes
RESEARCH_TASK_CONTROL_ROUTE_PREFIX=/v1/tasks

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
# Mount the MCP server on the same process as this application
RESEARCH_INCLUDE_MCP=true
# HTTP path where the MCP server is mounted when enabled
RESEARCH_MCP_MOUNT_PATH=/mcp

# -----------------------------------------------------------------------------
# Background workers
# -----------------------------------------------------------------------------
# Run the in-process scheduler with this application
RESEARCH_INCLUDE_SCHEDULER=true
# Run the in-process queue worker with this application
RESEARCH_INCLUDE_QUEUE_WORKER=false

# -----------------------------------------------------------------------------
# Tools / RAG
# -----------------------------------------------------------------------------
# Enable web search tools (enabled by default on research SKU)
# RESEARCH_ENABLE_WEBSEARCH=true
# Enable RAG retrieval tools
# RESEARCH_ENABLE_RAG=false
# Enable RAG ingest tools
# RESEARCH_ENABLE_RAG_INGEST=false
# Comma-separated allowlist of enabled tool ids
# RESEARCH_ENABLED_TOOLS=rag.retrieve,rag.ingest_document

# =============================================================================
# Platform configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Shared platform runtime environment (dev, test, stage, prod)
INTERGRAX_ENV=dev

# -----------------------------------------------------------------------------
# Integration profiles
# -----------------------------------------------------------------------------
# INTERGRAX_INTEGRATION_DOCUMENT_PARSER=docling
# INTERGRAX_INTEGRATION_SEARCH_PROVIDER=google_cse
