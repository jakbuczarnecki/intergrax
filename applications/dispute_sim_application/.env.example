# DISPUTE_SIM_* - copy to .env (gitignored) in this application directory.
# Application settings use the DISPUTE_SIM_* prefix.
# Platform INTERGRAX_* catalog: docs/project/technical/guides/PLATFORM_CONFIGURATION.md

# =============================================================================
# Application configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Application runtime environment (dev, test, stage, prod)
DISPUTE_SIM_BACKEND_ENV=dev

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
# Bind address for the application HTTP server
DISPUTE_SIM_BACKEND_HOST=127.0.0.1
# TCP port for the application HTTP server
DISPUTE_SIM_BACKEND_PORT=8025
# URL prefix for this application's HTTP routes
DISPUTE_SIM_ROUTE_PREFIX=/v1/dispute_sim

# -----------------------------------------------------------------------------
# Agents
# -----------------------------------------------------------------------------
# Default agent id when a request does not name one
DISPUTE_SIM_DEFAULT_AGENT_ID=dispute_intake

# -----------------------------------------------------------------------------
# Identity
# -----------------------------------------------------------------------------
# Where the API reads caller identity (body_or_context or context_only)
DISPUTE_SIM_IDENTITY_SOURCE=body_or_context

# -----------------------------------------------------------------------------
# Interactions
# -----------------------------------------------------------------------------
# Expose interaction HTTP routes on this application
DISPUTE_SIM_INCLUDE_INTERACTIONS=true
# URL prefix for interaction routes
DISPUTE_SIM_INTERACTION_ROUTE_PREFIX=/v1/interactions

# -----------------------------------------------------------------------------
# Task control
# -----------------------------------------------------------------------------
# Expose task-control HTTP routes on this application
DISPUTE_SIM_INCLUDE_TASK_CONTROL=true
# URL prefix for task-control routes
DISPUTE_SIM_TASK_CONTROL_ROUTE_PREFIX=/v1/tasks

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
# Mount the MCP server on the same process as this application
DISPUTE_SIM_INCLUDE_MCP=true
# HTTP path where the MCP server is mounted when enabled
DISPUTE_SIM_MCP_MOUNT_PATH=/mcp

# -----------------------------------------------------------------------------
# Background workers
# -----------------------------------------------------------------------------
# Run the in-process scheduler with this application
DISPUTE_SIM_INCLUDE_SCHEDULER=true
# Run the in-process queue worker with this application
# DISPUTE_SIM_INCLUDE_QUEUE_WORKER=false

# -----------------------------------------------------------------------------
# API authentication
# -----------------------------------------------------------------------------
# Optional dev API key (prod requires keys or ALLOW_UNAUTHENTICATED=true)
# DISPUTE_SIM_BACKEND_BOOTSTRAP_API_KEY=dev-key
# DISPUTE_SIM_BACKEND_BOOTSTRAP_TENANT_ID=dev-tenant
# DISPUTE_SIM_BACKEND_BOOTSTRAP_USER_ID=dev-user

# Example capability for POST /v1/dispute_sim/run
# DEFAULT_CAPABILITY=dispute.intake

# =============================================================================
# Platform configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Shared platform runtime environment (dev, test, stage, prod)
INTERGRAX_ENV=dev
