# POC_TEMPLATE_* - copy to .env (gitignored) in this application directory.
# Application settings use the POC_TEMPLATE_* prefix.
# Platform INTERGRAX_* catalog: docs/project/technical/guides/PLATFORM_CONFIGURATION.md

# =============================================================================
# Application configuration
# =============================================================================

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
# Bind address for the application HTTP server
POC_TEMPLATE_BACKEND_HOST=127.0.0.1
# TCP port for the application HTTP server
POC_TEMPLATE_BACKEND_PORT=8095
# URL prefix for this application\'s HTTP routes
POC_TEMPLATE_ROUTE_PREFIX=/v1/poc_template

# -----------------------------------------------------------------------------
# Interactions
# -----------------------------------------------------------------------------
# Expose interaction HTTP routes on this application
POC_TEMPLATE_INCLUDE_INTERACTIONS=true
# Interaction UI/API surface to mount (auto selects the default)
POC_TEMPLATE_INTERACTION_SURFACE=auto

# -----------------------------------------------------------------------------
# Task control
# -----------------------------------------------------------------------------
# Expose task-control HTTP routes on this application
POC_TEMPLATE_INCLUDE_TASK_CONTROL=true
# URL prefix for task-control routes
POC_TEMPLATE_TASK_CONTROL_ROUTE_PREFIX=/v1/tasks

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
# Mount the MCP server on the same process as this application
POC_TEMPLATE_INCLUDE_MCP=true
# HTTP path where the MCP server is mounted when enabled
POC_TEMPLATE_MCP_MOUNT_PATH=/mcp

# -----------------------------------------------------------------------------
# Background workers
# -----------------------------------------------------------------------------
# Run the in-process scheduler with this application
POC_TEMPLATE_INCLUDE_SCHEDULER=true
# Run the in-process queue worker with this application
POC_TEMPLATE_INCLUDE_QUEUE_WORKER=false

# Example run capability for POST /v1/poc_template/run
# DEFAULT_CAPABILITY=echo.basic

# =============================================================================
# Platform configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Shared platform runtime environment (dev, test, stage, prod)
INTERGRAX_ENV=dev

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# Optional per-task KV memory database (SQLite)
# INTERGRAX_TASK_MEMORY_DB=build/poc_task_memory.db
